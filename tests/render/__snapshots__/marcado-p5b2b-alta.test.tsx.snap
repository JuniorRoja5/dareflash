 w-5 shrink-0" type="checkbox"><span>Acepto la <a class="underline underline-offset-2" href="/privacidad">política de privacidad</a> y los términos.</span></label></div></fieldset></div><div class="sticky bottom-[calc(3.9rem+env(safe-area-inset-bottom))] z-20 -mx-4 border-t border-line bg-void/95 px-4 py-3 backdrop-blur-md sm:mx-0 sm:rounded-sm sm:border lg:static lg:border-0 lg:bg-transparent lg:p-0 lg:backdrop-blur-none"><div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4"><button type="submit" class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-sm border px-5 text-sm font-semibold transition-[filter,background-color,border-color] duration-150 ease-mechanical disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:brightness-100 disabled:hover:bg-transparent bg-action text-void border-transparent hover:brightness-110 w-full shrink-0 whitespace-nowrap sm:w-auto">Crear cuenta de empresa</button><p role="alert" class="text-sm text-alarm">No hemos podido registrar la empresa.</p></div></div></form>"`;

exports[`/empezar/empresa > la página, con todo lo que falta 1`] = `"<div class="df-rise mx-auto w-full max-w-6xl px-4 py-8 lg:px-8 lg:py-12"><h1 class="text-2xl text-text lg:text-3xl">Registra tu empresa</h1><p class="mt-2 max-w-prose text-sm text-text-dim">Las revisamos a mano, una por una. Cuéntanos quién eres y te escribimos en cuanto esté.</p><div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start lg:gap-10"><aside aria-label="Qué te llevas" class="space-y-4 lg:sticky lg:top-24 lg:order-2"><div class="rounded-sm border border-line bg-surface p-4 p-5"><h2 class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Qué te llevas</h2><ul class="mt-3 space-y-2 text-sm text-text"><li>Patrocina retos con tu marca: tú pones el reto y el premio.</li><li>Créditos de publicidad: Un día de campaña cuesta 1 crédito en una ciudad y 15 en todo el mundo, y se descuenta cada día que se muestra.</li><li class="text-text-dim">Lo ves todo, pero no participas: ni subes vídeos ni votas.</li></ul></div><div class="rounded-sm border border-line bg-surface p-4 border-text/40 p-5"><p class="text-sm font-medium text-text">Socios Fundadores: las empresas que verifiquemos antes del 30 de junio de 2027 se llevan 90 créditos de publicidad de regalo: hasta 90 días anunciándote en tu ciudad si tienes un local, o 18 días anunciándote en un país si vendes online o eres una marca.</p></div><div class="rounded-sm border border-line bg-surface p-4 p-5 hidden lg:block"><h2 class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Después de enviar</h2><ol class="mt-3 space-y-2 text-sm text-text-dim"><li class="flex gap-3"><span class="w-4 shrink-0 font-semibold text-text tabular-nums">1</span><span>Te enviamos un correo para confirmar tu dirección.</span></li><li class="flex gap-3"><span class="w-4 shrink-0 font-semibold text-text tabular-nums">2</span><span>Revisamos tu empresa a mano, una por una.</span></li><li class="flex gap-3"><span class="w-4 shrink-0 font-semibold text-text tabular-nums">3</span><span>Te escribimos en cuanto la decidamos. Si no podemos verificarla, te decimos por qué.</span></li></ol></div></aside><div class="min-w-0 lg:order-1"><form class="space-y-4"><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><fieldset><legend class="text-base font-semibold text-text">Tu negocio</legend><div class="mt-4 grid gap-4 sm:grid-cols-2"><div class="sm:col-span-2"><label for="nombre" class="mb-1.5 block text-sm font-medium text-text">Nombre comercial</label><div class="relative"><input id="nombre" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" maxlength="120" autocomplete="organization" placeholder="Como te conoce la gente" value=""></div></div><div class=""><label for="tipoCuenta" class="mb-1.5 block text-sm font-medium text-text">¿Quién firma la cuenta?</label><select id="tipoCuenta" class="min-h-[44px] w-full rounded-sm border border-line bg-surface px-3.5 text-base text-text focus:bg-raised focus:border-text"><option value="EMPRESA">Empresa</option><option value="MARCA_PERSONAL">Marca personal</option></select></div><div class=""><label for="tipoNegocio" class="mb-1.5 block text-sm font-medium text-text">¿Qué clase de negocio es?</label><select id="tipoNegocio" class="min-h-[44px] w-full rounded-sm border border-line bg-surface px-3.5 text-base text-text focus:bg-raised focus:border-text"><option value="FISICO">Negocio físico</option><option value="ONLINE">Negocio online</option><option value="MARCA_O_DIGITAL">Marca o producto digital</option></select></div></div></fieldset></div><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><fieldset><legend class="text-base font-semibold text-text">Ubicación</legend><div class="mt-4 grid gap-4 sm:grid-cols-2"><div class=""><label for="paisIso" class="mb-1.5 block text-sm font-medium text-text">País</label><select id="paisIso" autocomplete="country" class="min-h-[44px] w-full rounded-sm border border-line bg-surface px-3.5 text-base text-text focus:bg-raised focus:border-text"><option value="AF">Afganistán</option><option value="AL">Albania</option><option value="DE">Alemania</option><option value="AD">Andorra</option><option value="AO">Angola</option><option value="AI">Anguila</option><option value="AQ">Antártida</option><option value="AG">Antigua y Barbuda</option><option value="SA">Arabia Saudí</option><option value="DZ">Argelia</option><option value="AR">Argentina</option><option value="AM">Armenia</option><option value="AW">Aruba</option><option value="AU">Australia</option><option value="AT">Austria</option><option value="AZ">Azerbaiyán</option><option value="BS">Bahamas</option><option value="BD">Bangladés</option><option value="BB">Barbados</option><option value="BH">Baréin</option><option value="BE">Bélgica</option><option value="BZ">Belice</option><option value="BJ">Benín</option><option value="BM">Bermudas</option><option value="BY">Bielorrusia</option><option value="BO">Bolivia</option><option value="BA">Bosnia y Herzegovina</option><option value="BW">Botsuana</option><option value="BR">Brasil</option><option value="BN">Brunéi</option><option value="BG">Bulgaria</option><option value="BF">Burkina Faso</option><option value="BI">Burundi</option><option value="BT">Bután</option><option value="CV">Cabo Verde</option><option value="KH">Camboya</option><option value="CM">Camerún</option><option value="CA">Canadá</option><option value="BQ">Caribe neerlandés</option><option value="QA">Catar</option><option value="TD">Chad</option><option value="CZ">Chequia</option><option value="CL">Chile</option><option value="CN">China</option><option value="CY">Chipre</option><option value="VA">Ciudad del Vaticano</option><option value="CO">Colombia</option><option value="KM">Comoras</option><option value="CG">Congo</option><option value="KP">Corea del Norte</option><option value="KR">Co