abel for="direccion" class="mb-1.5 block text-sm font-medium text-text">Dirección (opcional)</label><div class="relative"><input id="direccion" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" maxlength="200" autocomplete="street-address" placeholder="Calle y número" value=""></div></div><p class="mt-1.5 text-2xs text-text-dim">Solo para comprobar quién eres: no se publica.</p></div></div></fieldset></div><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><fieldset><legend class="text-base font-semibold text-text">Contacto</legend><p class="mt-1 text-sm text-text-dim">Déjanos tu web o tus redes: con uno de los dos nos basta para comprobar que existís.</p><div class="mt-4 grid gap-4 sm:grid-cols-2"><div class=""><label for="personaContacto" class="mb-1.5 block text-sm font-medium text-text">Persona de contacto</label><div class="relative"><input id="personaContacto" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" maxlength="120" autocomplete="name" placeholder="Con quién hablamos" value="Ana"></div></div><span class="hidden sm:block" aria-hidden="true"></span><div class=""><label for="webUrl" class="mb-1.5 block text-sm font-medium text-text">Web</label><div class="relative"><input id="webUrl" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" inputmode="url" autocomplete="url" maxlength="300" placeholder="https://…" type="url" value=""></div></div><div class=""><label for="redes" class="mb-1.5 block text-sm font-medium text-text">Redes</label><div class="relative"><input id="redes" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" maxlength="300" placeholder="@tunegocio, un enlace…" value=""></div></div></div></fieldset></div><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><fieldset><legend class="text-base font-semibold text-text">Datos fiscales (opcional)</legend><p class="mt-1 text-sm text-text-dim">La identificación fiscal solo la vemos nosotros al verificarte: no sale en ningún listado ni en ningún correo.</p><div class="mt-4 grid gap-4 sm:grid-cols-2"><div class=""><label for="fiscalId" class="mb-1.5 block text-sm font-medium text-text">Identificación fiscal</label><div class="relative"><input id="fiscalId" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" maxlength="60" autocomplete="off" placeholder="NIF, CIF, RUT, RFC…" value=""></div></div></div></fieldset></div><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><fieldset><legend class="text-base font-semibold text-text">Acceso</legend><p class="mt-1 text-sm text-text-dim">Usa un correo que no tenga ya cuenta en RevolFlash: una cuenta de empresa no participa, así que no se puede convertir una cuenta de participante en una.</p><div class="mt-4 grid gap-4 sm:grid-cols-2"><div class=""><label for="email" class="mb-1.5 block text-sm font-medium text-text">Correo</label><div class="relative"><input id="email" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" inputmode="email" autocomplete="email" maxlength="254" type="email" value=""></div></div><div class=""><label for="password" class="mb-1.5 block text-sm font-medium text-text">Contraseña</label><div class="relative"><input id="password" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" autocomplete="new-password" maxlength="200" type="password" value=""></div></div><label class="flex min-h-[44px] items-start gap-3 py-2 text-sm text-text sm:col-span-2"><input class="mt-0.5 h-5 w-5 shrink-0" type="checkbox"><span>Acepto la <a class="underline underline-offset-2" href="/privacidad">política de privacidad</a> y los términos.</span></label></div></fieldset></div><div class="sticky bottom-[calc(3.9rem+env(safe-area-inset-bottom))] z-20 -mx-4 border-t border-line bg-void/95 px-4 py-3 backdrop-blur-md sm:mx-0 sm:rounded-sm sm:border lg:static lg:border-0 lg:bg-transparent lg:p-0 lg:backdrop-blur-none"><div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4"><button type="submit" class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-sm border px-5 text-sm font-semibold transition-[filter,background-color,border-color] duration-150 ease-mechanical disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:brightness-100 disabled:hover:bg-transparent bg-action text-void border-transparent hover:brightness-110 w-full shrink-0 whitespace-nowrap sm:w-auto" disabled="">Crear cuenta de empresa</button><p class="text-2xs text-text-dim" aria-live="polite"><span class="sm:hidden">Falta: la web o las redes y 3 más.</span><span class="hidden sm:inline">Falta: la web o las redes, el correo, la contraseña, aceptar la política de privacidad.</span></p></div></div></form>"`;

exports[`/empezar/empresa > el formulario: falta poco, error con y sin mensaje, sin conexión y recibido > recibido 1`] = `"<div class="df-rise mx-auto w-full max-w-6xl px-4 py-8 lg:px-8 lg:py-12"><h1 class="text-2xl text-text lg:text-3xl">Registra tu empresa</h1><p class="mt-2 max-w-prose text-sm text-text-dim">Las revisamos a mano, una por una. Cuéntanos quién eres y te escribimos en cuanto esté.</p><div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start lg:gap-10"><aside aria-label="Qué te llevas" class="space-y-4 lg:sticky lg:top-24 lg:order-2"><div class="rounded-sm border border-line bg-surface p-4 p-5"><h2 class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Qué te llevas</h2><ul class="mt-3 space-y-2 text-sm text-text"><li>Patrocina retos con tu marca: tú pones el reto y el premio.</li><li>Créditos de publicidad: Un día de campaña cuesta 1 crédito en una ciudad y 15 en todo el mundo, y se descuenta cada día que se muestra.</li><li class="text-text-dim">Lo ves todo, pero no participas: ni subes vídeos ni votas.</li></ul></div><div class="rounded-sm border border-line bg-surface p-4 border-text/40 p-5"><p class="text-sm font-medium text-text">Socios Fundadores: las empresas que verifiquemos antes del 30 de junio de 2027 se llevan 90 créditos de publicidad de regalo: hasta 90 días anunciándote en tu ciudad si tienes un local, o 18 días anunciándote en un país si vendes online o eres una marca.</p></div><div class="rounded-sm border border-line bg-surface p-4 p-5 hidden lg:block"><h2 class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Después de enviar</h2><ol class="mt-3 space-y-2 text-sm text-text-dim"><li class="flex gap-3"><span class="w-4 shrink-0 font-semibold text-text tabular-nums">1</span><span>Te enviamos un correo para confirmar tu dirección.</span></li><li class="flex gap-3"><span class="w-4 shrink-0 font-semibold text-text tabular-nums">2</span><span>Revisamos tu empresa a mano, una por una.</span></li><li class="flex gap-3"><span class="w-4 shrink-0 font-semibold text-text tabular-nums">3</span><span>Te escribimos en cuanto la decidamos. Si no podemos verificarla, te decimos por qué.</span></li></ol></div></aside><div class="min-w-0 lg:order-1"><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6" role="status"><p class="text-base font-semibold text-text">Recibido.</p><p class="mt-2 max-w-prose text-sm text-text">Revisa tu correo. Te hemos enviado un mensaje para continuar con el registro de tu empresa.</p></div><div class="rounded-sm border border-line bg-surface p-4 p-5 mt-6 lg:hidden"><h2 class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Después de enviar</h2><ol class="mt-3 space-y-2 text-sm text-text-dim"><li class="flex gap-3"><span class="w-4 shrink-0 font-semibold text-text tabular-nums">1</span><span>Te enviamos un correo para confirmar tu dirección.</span></li><li class="flex gap-3"><span class="w-4 shrink-0 font-semibold text-text tabular-nums">2</span><span>Revisamos tu empresa a mano, una por una.</span></li><li class="flex gap-3"><span class="w-4 shrink-0 font-semibold text-text tabular-nums">3</span><span>Te escribimos en cuanto la decidamos. Si no podemos verificarla, te decimos por qué.</span></li></ol></div></div></div></div>"`;

exports[`/empezar/empresa > el formulario: falta poco, error con y sin mensaje, sin conexión y recibido > sin conexión 1`] = `"<form class="space-y-4"><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><fieldset><legend class="text-base font-semibold text-text">Tu negocio</legend><div class="mt-4 grid gap-4 sm:grid-cols-2"><div class="sm:col-span-2"><label for="nombre" class="mb-1.5 block text-sm font-medium text-text">Nombre comercial</label><div class="relative"><input id="nombre" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" maxlength="120" autocomplete="organization" placeholder="Como te conoce la gente" value="Bar Ana"></div></div><div class=""><label for="tipoCuenta" class="mb-1.5 block text-sm font-medium text-text">¿Quién firma la cuenta?</label><select id="tipoCuenta" class="min-h-[44px] w-full rounded-sm border border-line bg-surface px-3.5 text-base text-text focus:bg-raised focus:border-text"><option value="EMPRESA">Empresa</option><option value="MARCA_PERSONAL">Marca personal</option></select></div><div class=""><label for="tipoNegocio" class="mb-1.5 block text-sm font-medium text-text">¿Qué clase de negocio es?</label><select id="tipoNegocio" class="min-h-[44px] w-full rounded-sm border border-line bg-surface px-3.5 text-base text-text focus:bg-raised focus:border-text"><option value="FISICO">Negocio físico</option><option value="ONLINE">Negocio online</option><option value="MARCA_O_DIGITAL">Marca o producto digital</option></select></div></div></fieldset></div><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><fieldset><legend class="text-base font-semibold text-text">Ubicación</legend><div class="mt-4 grid gap-4 sm:grid-cols-2"><div class=""><label for="paisIso" class="mb-1.5 block text-sm font-medium text-text">País</label><select id="paisIso" autocomplete="country" class="min-h-[44px] w-full rounded-sm 