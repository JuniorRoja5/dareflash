exports[`/empezar > los dos caminos, con el aviso de Socios Fundadores 1`] = `"<div class="df-rise mx-auto w-full max-w-5xl px-4 py-10 lg:px-8 lg:py-16"><h1 class="text-3xl text-text lg:text-4xl">¿Cómo quieres usar RevolFlash?</h1><p class="mt-2 max-w-prose text-sm text-text-dim lg:text-base">Dos cuentas distintas, y no se pueden mezclar: elige con cuál entras.</p><div class="mt-8 grid gap-4 md:grid-cols-2 lg:mt-10 lg:gap-6"><div class="rounded-sm border border-line bg-surface p-4 flex flex-col p-6 lg:p-8"><p class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Participante</p><h2 class="mt-2 text-xl text-text lg:text-2xl">Quiero participar</h2><p class="mt-2 flex-1 text-sm text-text-dim">Sube tus vídeos, compite en los retos y gana premios de verdad.</p><a class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-sm border px-5 text-sm font-semibold transition-[filter,background-color,border-color] duration-150 ease-mechanical disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:brightness-100 disabled:hover:bg-transparent bg-action text-void border-transparent hover:brightness-110 mt-6 w-full sm:w-auto sm:self-start" href="/entrar?registro=1">Crear mi cuenta</a></div><div class="rounded-sm border border-line bg-surface p-4 flex flex-col p-6 lg:p-8"><p class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Negocio</p><h2 class="mt-2 text-xl text-text lg:text-2xl">Soy un negocio</h2><p class="mt-2 text-sm text-text-dim">Patrocina retos y anúnciate donde está tu gente. Una cuenta de empresa lo ve todo, pero no participa: ni sube vídeos ni vota.</p><p class="mt-4 rounded-sm border border-text/40 px-3 py-2 text-sm text-text">Socios Fundadores: las empresas que verifiquemos antes del 30 de junio de 2027 se llevan 90 créditos de publicidad de regalo: hasta 90 días anunciándote en tu ciudad si tienes un local, o 18 días anunciándote en un país si vendes online o eres una marca.</p><span class="flex-1" aria-hidden="true"></span><a class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-sm border px-5 text-sm font-semibold transition-[filter,background-color,border-color] duration-150 ease-mechanical disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:brightness-100 disabled:hover:bg-transparent bg-transparent text-text border-line hover:bg-raised mt-6 w-full sm:w-auto sm:self-start" href="/empezar/empresa">Registrar mi empresa</a></div></div></div>"`;

exports[`/empezar/empresa > el formulario: falta poco, error con y sin mensaje, sin conexión y recibido > completo 1`] = `"<form class="space-y-4"><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><fieldset><legend class="text-base font-semibold text-text">Tu negocio</legend><div class="mt-4 grid gap-4 sm:grid-cols-2"><div class="sm:col-span-2"><label for="nombre" class="mb-1.5 block text-sm font-medium text-text">Nombre comercial</label><div class="relative"><input id="nombre" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" maxlength="120" autocomplete="organization" placeholder="Como te conoce la gente" value="Bar Ana"></div></div><div class=""><label for="tipoCuenta" class="mb-1.5 block text-sm font-medium text-text">¿Quién firma la cuenta?</label><select id="tipoCuenta" class="min-h-[44px] w-full rounded-sm border border-line bg-surface px-3.5 text-base text-text focus:bg-raised focus:border-text"><option value="EMPRESA">Empresa</option><option value="MARCA_PERSONAL">Marca personal</option></select></div><div class=""><label for="tipoNegocio" class="mb-1.5 block text-sm font-medium text-text">¿Qué clase de negocio es?</label><select id="tipoNegocio" class="min-h-[44px] w-full rounded-sm border border-line bg-surface px-3.5 text-base text-text focus:bg-raised focus:border-text"><option value="FISICO">Negocio físico</option><option value="ONLINE">Negocio online</option><option value="MARCA_O_DIGITAL">Marca o producto digital</option></select></div></div></fieldset></div><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><fieldset><legend class="text-base font-semibold text-text">Ubicación</legend><div class="mt-4 grid gap-4 sm:grid-cols-2"><div class=""><label for="paisIso" class="mb-1.5 block text-sm font-medium text-text">País</label><select id="paisIso" autocomplete="country" class="min-h-[44px] w-full rounded-sm bord