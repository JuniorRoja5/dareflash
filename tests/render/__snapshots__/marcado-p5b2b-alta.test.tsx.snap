 w-5 shrink-0" type="checkbox"><span>Acepto la <a class="underline underline-offset-2" href="/privacidad">política de privacidad</a> y los términos.</span></label></div></fieldset></div><div class="sticky bottom-[calc(3.9rem+env(safe-area-inset-bottom))] z-20 -mx-4 border-t border-line bg-void/95 px-4 py-3 backdrop-blur-md sm:mx-0 sm:rounded-sm sm:border lg:static lg:border-0 lg:bg-transparent lg:p-0 lg:backdrop-blur-none"><div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4"><button type="submit" class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-sm border px-5 text-sm font-semibold transition-[filter,background-color,border-color] duration-150 ease-mechanical disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:brightness-100 disabled:hover:bg-transparent bg-action text-void border-transparent hover:brightness-110 w-full shrink-0 whitespace-nowrap sm:w-auto">Crear cuenta de empresa</button><p role="alert" class="text-sm text-alarm">Del servidor.</p></div></div></form>"`;

