exports[`/wallet > por encima del mínimo: pedir cobro, dos métodos, cada estado y más páginas > página 1`] = `"<div class="df-rise mx-auto w-full max-w-6xl px-4 py-8 lg:px-8 lg:py-12 xl:grid xl:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] xl:items-start xl:gap-10"><div class="min-w-0 space-y-8"><section aria-labelledby="mi-saldo" style="--df-halo-color: var(--df-money);" class="relative overflow-hidden rounded-sm border border-line bg-surface/60 p-6 shadow-[var(--df-shadow-md)] backdrop-blur-md lg:p-10"><span class="df-halo" aria-hidden="true"></span><div class="relative min-w-0"><p class="text-2xs tracking-widest text-text-dim uppercase" aria-hidden="true">Tu monedero</p><h1 id="mi-saldo" class="mt-1 leading-none"><span class="sr-only">Saldo disponible: </span><span class="tabular-nums text-money block" style="font-family: var(--font-display); font-variation-settings: &quot;wght&quot; 850, &quot;wdth&quot; 125; font-variant-numeric: tabular-nums; font-size: 64px; line-height: 1; white-space: nowrap;"><span style="font-size: 0.5em; vertical-align: 0.5em;">$</span><span>90</span><span style="font-size: 0.5em;">.</span><span style="font-size: 0.5em;">00</span></span></h1><p class="mt-3 max-w-prose text-sm text-text-dim">Lo que ganas en los retos se acumula aquí. Cuando llegues al mínimo, puedes pedir que te lo enviemos al banco.</p><div class="mt-4 flex flex-wrap items-center gap-2 text-sm"><span class="inline-flex items-center rounded-full border border-line px-3 py-1 text-text-dim">Puedes cobrar desde $50.00</span><span class="inline-flex items-center rounded-full border border-line px-3 py-1 text-text-dim">$60.00 en curso</span><span class="inline-flex items-center rounded-full border border-line px-3 py-1 text-text-dim">$120.00 cobrados</span></div></div></section><form class="space-y-5 rounded-sm border border-line bg-surface/60 p-6 shadow-[var(--df-shadow-sm)] backdrop-blur-md" aria-label="Pedir un cobro"><h2 class="font-medium text-text">Pedir un cobro</h2><div><div