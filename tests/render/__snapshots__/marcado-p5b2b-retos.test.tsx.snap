exports[`/empresa/retos/nuevo > verificada: el formulario, cada error y el envío > cierre antes de la apertura 1`] = `"<form class="space-y-4" novalidate=""><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><fieldset><legend class="text-base font-semibold text-text">El reto</legend><div class="mt-4 grid gap-4 sm:grid-cols-2"><div class="sm:col-span-2"><label for="title" class="mb-1.5 block text-sm font-medium text-text">Título</label><div class="relative"><input id="title" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" maxlength="120" autocomplete="off" placeholder="Lo que la gente verá en la tarjeta" value="Pan de masa madre"></div></div><div><label for="category" class="mb-1.5 block text-sm font-medium text-text">Categoría</label><select id="category" class="min-h-[44px] w-full rounded-sm border border-line bg-surface px-3.5 text-base text-text focus:bg-raised focus:border-text"><option value="humor">Humor</option><option value="fitness">Fitness</option><option value="musica">Música</option><option value="baile">Baile</option><option value="gaming">Gaming</option><option value="lifestyle">Lifestyle</option><option value="street">Street</option><option value="arte">Arte</option><option value="viajes">Viajes</option><option value="talento">Talento</option><option value="tecnologia">Tecnología</option><option value="moda">Moda</option><option value="motivacion">Motivación</option><option value="retos">Retos</option></select></div><span class="hidden sm:block" aria-hidden="true"></span><div class="sm:col-span-2"><label for="description" class="mb-1.5 block text-sm font-medium text-text">Qué tiene que hacer la gente</label><textarea id="description" rows="4" maxlength="2000" class="w-full rounded-sm border border-line bg-surface px-3.5 py-2.5 text-base text-text focus:bg-raised focus:border-text"></textarea></div><div class="sm:col-span-2"><label for="rules" class="mb-1.5 block text-sm font-medium text-text">Reglas (opcional)</label><textarea id="rules" rows="3" maxlength="4000" class="w-full rounded-sm border border-line bg-surface px-3.5 py-2.5 text-base text-text focus:bg-raised focus:border-text"></textarea></div></div></fieldset></div><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><fieldset><legend class="text-base font-semibold text-text">Premio y fechas</legend><p class="mt-1 text-sm text-text-dim">Las fechas, en tu hora local.</p><div class="mt-4 grid gap-4 sm:grid-cols-2"><div class=""><label for="premio" class="mb-1.5 block text-sm font-medium text-text">Premio (USD)</label><div class="relative"><input id="premio" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" inputmode="decimal" autocomplete="off" placeholder="50" value="50"></div></div><div class=""><label for="winnersCount" class="mb-1.5 block text-sm font-medium text-text">Ganadores</label><div class="relative"><input id="winnersCount" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" inputmode="numeric" min="1" type="number" value="1"></div></div><div class=""><label for="startsAt" class="mb-1.5 block text-sm font-medium text-text">Abre</label><div class="relative"><input id="startsAt" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" type="datetime-local" value="2026-12-10T10:00"></div></div><div class=""><label for="deadline" class="mb-1.5 block text-sm font-medium text-text">Cierra</label><div class="relative"><input id="deadline" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" type="datetime-local" value="2026-12-01T10:00"></div></div></div></fieldset></div><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><fieldset><legend class="text-base font-semibold text-text">Tu marca</legend><div class="mt-4 grid gap-4 sm:grid-cols-2"><div class="sm:col-span-2"><label for="sponsorLogo" class="mb-1.5 block text-sm font-medium text-text">Logo (opcional)</label><input id="sponsorLogo" accept="image/png,image/jpeg,image/webp" class="block w-full text-sm text-text-dim file:mr-3 file:min-h-[44px] file:rounded-sm file:border file:border-line file:bg-surface file:px-4 file:text-sm file:text-text" type="file"><p class="mt-1.5 text-2xs text-text-dim">PNG, JPG o WebP. Saldrá junto a «Patrocinado por» con el nombre de tu empresa.</p></div></div></fieldset></div><div class="sticky bottom-[calc(3.9rem+env(safe-area-inset-bottom))] z-20 -mx-4 border-t border-line bg-void/95 px-4 py-3 backdrop-blur-md sm:mx-0 sm:rounded-sm sm:border lg:static lg:border-0 lg:bg-transparent lg:p-0 lg:backdrop-blur-none"><div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4"><button type="submit" class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-sm border px-5 text-sm font-semibold transition-[filter,background-color,border-color] duration-150 ease-mechanical disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:brightness-100 disabled:hover:bg-transparent bg-action text-void border-transparent hover:brightness-110 w-full shrink-0 whitespace-nowrap sm:w-auto">Enviar propuesta</button><p role="alert" class="text-sm text-alarm">El cierre tiene que ser después de la apertura.</p></div></div></form>"`;

