exports[`/empresa/retos > con una propuesta en cada estado y un extracto de varios retos 1`] = `"<div class="df-rise space-y-8"><div class="flex flex-wrap items-end justify-between gap-4"><div><h1 class="text-2xl text-text">Mis retos</h1><p class="mt-1 max-w-prose text-sm text-text-dim">Los retos patrocinados que nos propones, y lo que suma cada uno.</p></div><a class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-sm border px-5 text-sm font-semibold transition-[filter,background-color,border-color] duration-150 ease-mechanical disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:brightness-100 disabled:hover:bg-transparent bg-transparent text-text border-line hover:bg-raised " href="/empresa/retos/nuevo">Proponer un reto</a></div><section aria-labelledby="propuestas" class="space-y-3"><h2 id="propuestas" class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Tus propuestas</h2><div class="hidden overflow-x-auto md:block rounded-sm border border-line bg-surface"><table class="w-full border-collapse text-left text-sm"><thead class="border-b border-line"><tr><th class="pl-5 py-3 pr-4 whitespace-nowrap text-2xs font-semibold tracking-widest text-text-dim uppercase">Reto</th><th class="text-right py-3 pr-4 whitespace-nowrap text-2xs font-semibold tracking-widest text-text-dim uppercase">Premio</th><th class="py-3 pr-4 whitespace-nowrap text-2xs font-semibold tracking-widest text-text-dim uppercase">Abre – cierra</th><th class="pr-5 py-3 pr-4 whitespace-nowrap text-2xs font-semibold tracking-widest text-text-dim uppercase">Estado</th></tr></thead><tbody class="divide-y divide-line"><tr data-solicitud="a" class="align-top"><td class="max-w-[22rem] py-3 pr-4 pl-5"><p class="font-medium break-words text-text">Pan de masa madre</p><p class="text-2xs text-text-dim">Fitness</p></td><td class="py-3 pr-4 text-right whitespace-nowrap text-text tabular-nums">$150.00</td><td class="py-3 pr-4 whitespace-nowrap text-text-dim tabular-nums