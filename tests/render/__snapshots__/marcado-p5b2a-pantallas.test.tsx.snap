exports[`/ranking > vacía, con lista y más páginas (cargando), y el último reto > vacía 1`] = `"<div class="flex flex-wrap items-center justify-between gap-4"><h1 class="text-2xl leading-none text-text" style="font-family: var(--font-display); font-variation-settings: &quot;wght&quot; 780, &quot;wdth&quot; 118;">Clasificación</h1></div><div class="df-rise mt-8 rounded-sm border border-line bg-surface/60 p-10 text-center backdrop-blur-md"><p class="text-lg font-semibold text-text">Aún no ha ganado nadie este mes</p><p class="mx-auto mt-2 max-w-prose text-sm text-text-dim">La clasificación se llena cuando cierra el primer reto. Participa y sé el primero en ganar.</p></div>"`;

exports[`/ranking > vacía, con lista y más páginas (cargando), y el último reto > último reto 1`] = `"<div class="flex flex-wrap items-center justify-between gap-4"><h1 class="text-2xl leading-none text-text" style="font-family: var(--font-display); font-variation-settings: &quot;wght&quot; 780, &quot;wdth&quot; 118;">Clasificación</h1><div role="group" aria-label="Vista de la clasificación" class="inline-flex rounded-sm border border-line bg-surface/60 p-1 shadow-[var(--df-shadow-sm)] backdrop-blur-md"><button type="button" aria-pressed="false" class="min-h-[44px] rounded-xs px-4 text-sm whitespace-nowrap transition-colors duration-150 ease-mechanical text-text-dim hover:text-text">Este mes</button><button type="button" aria-pressed="true" class="min-h-[44px] rounded-xs px-4 text-sm whitespace-nowrap transition-colors duration-150 ease-mechanical bg-raised font-medium text-text">Último reto</button></div></div><section aria-label="Clasificación de «Salto largo»" class="df-rise mt-8"><h2 class="text-lg font-semibold text-balance break-words text-text">Clasificación de «Salto largo»</h2><div class="mt-4 overflow-hidden rounded-sm border border-line bg-surface/60 shadow-[var(--df-shadow-md)] backdrop-blur-md"><div class="flex items-center gap-3 border-b border-line py-2.5 last:border-b-0  "><span class="w-7 shrink-0 text-right text-lg font-semibold tabular-nums df-puesto-podio">1</span><span aria-hidden="true" class="inline-flex h-8 w-8 text-xs shrink-0 items-center justify-center overflow-hidden rounded-full bg-raised font-semibold text-text-dim">M</span><span class="min-w-0 flex-1 truncate font-medium">@mario</span><span class="shrink-0 text-sm tabular-nums text-text-dim">1 voto</span></div><div class="flex items-center gap-3 border-b border-line py-2.5 last:border-b-0  "><span class="w-7 shrink-0 text-right text-lg font-semibold tabular-nums df-puesto-podio">2</span><span aria-hidden="true" class="inline-flex h-8 w-8 text-xs shrink-0 items-center justify-center overflow-hidden rounded-full bg-raised font-semibold text-text-dim">A</span><span class="min-w-0 flex-1 truncate font-medium">@ana</span><span class="shrink-0 text-sm tabular-nums text-text-dim">7 votos</span></div></div></section>"`;
