exports[`/destacados > vacía, y con perfiles y más páginas > con perfiles 1`] = `"<div class="df-rescoldo" aria-hidden="true"></div><div class="df-rayos" aria-hidden="true"><svg viewBox="0 0 1200 760" preserveAspectRatio="xMidYMid slice" focusable="false"><path d="M150 40 L120 180 L165 200 L110 420 L150 440 L95 720"></path><path d="M420 10 L395 160 L440 180 L390 360 L430 380 L380 740"></path><path d="M640 30 L615 150 L660 175 L610 400 L650 420 L600 730"></path><path d="M860 20 L835 170 L880 190 L825 410 L870 430 L820 720"></path><path d="M1060 40 L1030 180 L1075 205 L1020 430 L1065 450 L1010 740"></path><path d="M280 120 L255 300 L300 320 L250 560"></path><path d="M960 120 L935 300 L980 320 L930 560"></path></svg></div><div class="df-rise mx-auto w-full max-w-7xl px-4 py-8 lg:px-8 lg:py-12"><header class="flex flex-wrap items-end justify-between gap-6"><div class="min-w-0"><h1 class="text-[clamp(2.25rem,6.5vw,4.5rem)] leading-[0.95] tracking-tight text-text" style="font-family: var(--font-display); font-variation-settings: &quot;wght&quot; 900, &quot;wdth&quot; 115;">Bajo los focos<br>ahora mismo</h1><p class="mt-4 max-w-[52ch] text-sm leading-relaxed text-text-dim sm:text-base">Quien enciende un Boost sube al escenario durante 1 hora. No se gana ganando retos: se gana apareciendo. El último en activar entra arriba.</p></div><a class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-sm border px-5 text-sm font-semibold transition-[filter,background-color,border-color] duration-150 ease-mechanical disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:brightness-100 disabled:hover:bg-transparent bg-action text-void border-transparent hover:brightness-110 shadow-[var(--df-cta-lift)] transition-shadow duration-[var(--df-dur-fast)] ease-mechanical hover:shadow-[var(--df-glow-hover)]" href="/boosts"><span class="flex flex-col items-start gap-0.5 text-left"><span>Destacar mi perfil</span><span class="text-2xs font-medium opacity-75">Consigue visibilidad ahora</span></span></a></header><div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"><a data-destacado="ana" data-nivel="pro" style="--df-halo-color: var(--df-nivel-pro);" class="relative flex flex-col items-center gap-2 overflow-hidden rounded-sm border border-line bg-surface/60 text-center shadow-[var(--df-shadow-sm)] backdrop-blur-md transition-[transform,box-shadow] duration-[var(--df-dur-fast)] ease-mechanical hover:-translate-y-0.5 df-vip-halo p-6" href="/u/ana"><span class="df-halo df-respira" aria-hidden="true"></span><span data-marca-boost="true" class="inline-flex shrink-0 items-center rounded-full border px-2 py-0.5 text-2xs font-semibold tracking-widest uppercase absolute top-3 right-3" style="color: var(--df-action); border-color: color-mix(in srgb, var(--df-action) 45%, transparent); background-color: color-mix(in srgb, var(--df-action) 12%, transparent);">Boost</span><span class="relative flex w-full flex-col items-center gap-2"><span class="relative inline-flex shrink-0 h-20 w-20"><span aria-hidden="true" class="inline-flex h-20 w-20 text-2xl shrink-0 items-center justify-center overflow-hidden rounded-full bg-raised font-semibold text-text-dim" style="box-shadow: 0 0 0 3.5px var(--df-nivel-pro);" data-nivel="pro">A</span><svg viewBox="0 0 24 24" role="img" aria-label="Nivel Pro" class="pointer-events-none absolute h-6 w-6 -right-1 -bottom-1" style="color: var(--df-nivel-pro);"><circle cx="12" cy="12" r="12" fill="currentColor"></circle><g fill="var(--df-void)"><path d="M12 3.5c3 3.2 1.3 5 3.1 7.4 1.6 2.1 1.3 5-.7 6.7a5.6 5.6 0 01-7.4-.3c-1.8-1.9-1.6-4.9.4-6.8C9.6 8.6 9 6.3 12 3.5zm.1 7.9c-1.4 1.3-2 2.6-1.3 3.9.5 1 1.7 1.4 2.7.9 1.2-.6 1.5-1.9.8-3.2-.4-.7-1.2-1.2-2.2-1.6z"></path></g></svg></span><span class="inline-flex min-w-0 max-w-full items-center gap-1.5 align-bottom mt-1 max-w-full truncate font-medium text-text text-base"><span class="df-nombre-vip truncate">Ana</span><span data-marca-vip="compacta" aria-label="VIP Mythic" title="VIP Mythic" role="img" class="inline-flex shrink-0 items-center justify-center bg-[var(--vip-gold)] font-black tracking-[0.04em] text-[var(--vip-tinta)] tabular-nums px-1 py-px text-[9px] rounded-[4px] " style="font-family: var(--font-display); line-height: 1;">VIP</span></span><span class="inline-flex items-center gap-2 rounded-full border border-line px-2.5 py-1 text-2xs font-medium tracking-wide text-text-dim uppercase"><span class="flex items-end gap-px" aria-hidden="true"><span class="w-[3px] shrink-0 bg-text" style="height: 4px;"></span><span class="w-[3px] shrink-0 bg-text" style="height: 6px;"></span><span class="w-[3px] shrink-0 bg-text" style="height: 8px;"></span><span class="w-[3px] shrink-0 bg-line" style="height: 10px;"></span><span class="w-[3px] shrink-0 bg-line" style="height: 12px;"></span></span>Pro</span></span></a></div><nav aria-label="Paginación" class="mt-6 flex items-center justify-between gap-3"><span></span><a rel="next" class="inline-flex min-h-[44px] items-center gap-1.5 rounded-sm border border-line px-4 text-sm font-medium text-text transition-colors duration-[var(--df-dur-fast)] ease-mechanical hover:bg-raised lg:min-h-[38px]" href="/destacados?cursor=c2">Siguiente <span aria-hidden="true">→</span></a></nav><p class="mt-10 text-2xs text-text-dim">Esto no es el ranking: aquí se aparece por haber gastado un Boost, no por ganar retos. <a class="underline underline-offset-2 hover:text-text" href="/ranking">Ver el ranking del mes</a>.</p></div>"`;

