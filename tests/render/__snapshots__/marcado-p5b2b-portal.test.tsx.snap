exports[`/empresa > con el correo sin verificar: el aviso 1`] = `"<div class="df-rise"><h1 class="text-2xl text-text">Tu empresa</h1><div class="mt-6"><div class="rounded-sm border border-line bg-surface p-4 max-w-prose"><h2 class="text-sm font-semibold text-text">Antes, confirma tu correo</h2><p class="mt-2 text-sm text-text-dim">Verifica tu correo para entrar al portal. Es la misma barrera que protege todo lo que tiene efectos.</p><a class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-sm border px-5 text-sm font-semibold transition-[filter,background-color,border-color] duration-150 ease-mechanical disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:brightness-100 disabled:hover:bg-transparent bg-transparent text-text border-line hover:bg-raised mt-4" href="/perfil">Ir a mi cuenta</a></div></div></div>"`;

exports[`/empresa > marca o producto digital 1`] = `"<div class="df-rise"><h1 class="text-2xl text-text">Bar Ana</h1><p class="mt-1 text-sm text-text-dim">Empresa · Marca o producto digital</p><div class="mt-6 grid gap-4 md:grid-cols-3"><div class="relative overflow-hidden rounded-sm border border-line bg-surface/60 p-4 shadow-[var(--df-shadow-sm)] backdrop-blur-md"><div class="relative flex items-start gap-3"><div class="min-w-0 flex-1"><p class="text-2xs tracking-widest text-text-dim uppercase">Estado</p><p class="mt-1.5 text-3xl leading-none font-semibold tabular-nums text-text">Verificada</p></div></div></div><div class="relative overflow-hidden rounded-sm border border-line bg-surface/60 p-4 shadow-[var(--df-shadow-sm)] backdrop-blur-md"><div class="relative flex items-start gap-3"><div class="min-w-0 flex-1"><p class="text-2xs tracking-widest text-text-dim uppercase">Créditos de publicidad</p><p class="mt-1.5 text-3xl leading-none font-semibold tabular-nums text-text"><span data-creditos-saldo="0">0</span></p><p class="mt-2 text-2xs text-text-dim">Un día de campaña cuesta 5 créditos por país y 15 en todo el mundo, y se descuenta cada día que se muestra.<a class="mt-1 block font-medium text-text underline underline-offset-2 hover:no-underline" href="/empresa/creditos">Ver movimientos</a></p></div></div></div><div class="relative overflow-hidden rounded-sm border border-line bg-surface/60 p-4 shadow-[var(--df-shadow-sm)] backdrop-blur-md"><div class="relative flex items-start gap-3"><div class="min-w-0 flex-1"><p class="text-2xs tracking-widest text-text-dim uppercase">Propuestas en revisión</p><p class="mt-1.5 text-3xl leading-none font-semibold tabular-nums text-text">0</p><p class="mt-2 text-2xs text-text-dim"><a class="font-medium text-text underline underline-offset-2 hover:no-underline" href="/empresa/retos">Ver mis retos</a></p></div></div></div></div><div class="mt-6 grid gap-4 lg:grid-cols-2 lg:items-start"><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><div class="flex flex-wrap items-center gap-2"><h2 class="text-base font-semibold text-text">Tu empresa está verificada</h2><span class="rounded-xs border border-line px-2 py-0.5 text-2xs text-text-dim">Verificada</span></div><p class="mt-2 max-w-prose text-sm text-text-dim">Ya puedes usar el portal. Lo que se puede hacer desde aquí irá creciendo.</p></div><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><h2 class="text-base font-semibold text-text">Los datos que nos diste</h2><dl class="mt-3 grid gap-4 sm:grid-cols-2"><div><dt class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Nombre</dt><dd class="mt-0.5 text-sm break-words text-text">Bar Ana</dd></div><div><dt class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Tipo de cuenta</dt><dd class="mt-0.5 text-sm break-words text-text">Empresa</dd></div><div><dt class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Tipo de negocio</dt><dd class="mt-0.5 text-sm break-words text-text">Marca o producto digital</dd></div><div><dt class="text-2xs font-semibold tracking-widest text-text-dim uppercase">País</dt><dd class="mt-0.5 text-sm break-words text-text">España</dd></div><div><dt class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Contacto</dt><dd class="mt-0.5 text-sm break-words text-text">Ana</dd></div><div><dt class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Alta</dt><dd class="mt-0.5 text-sm break-words text-text">3 de octubre de 2026</dd></div></dl><p class="mt-4 text-2xs text-text-dim">Para cambiar cualquiera de estos datos, escríbenos: los revisamos a mano.</p></div></div></div>"`;

exports[`/empresa > pendiente, sin datos opcionales 1`] = `"<div class="df-rise"><h1 class="text-2xl text-text">Bar Ana</h1><p class="mt-1 text-sm text-text-dim">Empresa · Negocio físico</p><div class="mt-6 grid gap-4 md:grid-cols-3"><div class="relative overflow-hidden rounded-sm border border-line bg-surface/60 p-4 shadow-[var(--df-shadow-sm)] backdrop-blur-md"><div class="relative flex items-start gap-3"><div class="min-w-0 flex-1"><p class="text-2xs tracking-widest text-text-dim uppercase">Estado</p><p class="mt-1.5 text-3xl leading-none font-semibold tabular-nums text-text">Pendiente</p></div></div></div><div class="relative overflow-hidden rounded-sm border border-line bg-surface/60 p-4 shadow-[var(--df-shadow-sm)] backdrop-blur-md"><div class="relative flex items-start gap-3"><div class="min-w-0 flex-1"><p class="text-2xs tracking-widest text-text-dim uppercase">Créditos de publicidad</p><p class="mt-1.5 text-3xl leading-none font-semibold tabular-nums text-text"><span data-creditos-saldo="0">0</span></p><p class="mt-2 text-2xs text-text-dim">Un día de campaña cuesta 1 crédito en una ciudad y 2 en una región, y se descuenta cada día que se muestra.<a class="mt-1 block font-medium text-text underline underline-offset-2 hover:no-underline" href="/empresa/creditos">Ver movimientos</a></p></div></div></div><div class="relative overflow-hidden rounded-sm border border-line bg-surface/60 p-4 shadow-[var(--df-shadow-sm)] backdrop-blur-md"><div class="relative flex items-start gap-3"><div class="min-w-0 flex-1"><p class="text-2xs tracking-widest text-text-dim uppercase">Propuestas en revisión</p><p class="mt-1.5 text-3xl leading-none font-semibold tabular-nums text-text">0</p><p class="mt-2 text-2xs text-text-dim"><a class="font-medium text-text underline underline-offset-2 hover:no-underline" href="/empresa/retos">Ver mis retos</a></p></div></div></div></div><div class="mt-6 grid gap-4 lg:grid-cols-2 lg:items-start"><div class="rounded-sm border border-line bg-surfa