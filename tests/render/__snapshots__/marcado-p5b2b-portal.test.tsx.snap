exports[`/empresa/cuenta > el correo, la contraseña y cerrar sesión 1`] = `"<div class="df-rise"><h1 class="text-2xl text-text">Cuenta</h1><p class="mt-1 max-w-prose text-sm text-text-dim">El correo con el que entras es también donde te escribimos sobre tu empresa.</p><div class="mt-6 grid gap-4 lg:grid-cols-2 lg:items-start"><section class="rounded-sm border border-line bg-surface/60 p-5"><h2 class="text-sm font-semibold tracking-widest text-text-dim uppercase">Tu correo</h2><p class="mt-2 text-sm text-text">ana@bar.test</p><form class="mt-4 space-y-3"><div class=""><label for="email-nuevo" class="mb-1.5 block text-sm font-medium text-text">Nueva dirección</label><div class="relative"><input id="email-nuevo" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" autocomplete="email" required="" type="email" value=""></div></div><div class=""><label for="email-password" class="mb-1.5 block text-sm font-medium text-text">Tu contraseña</label><div class="relative"><input id="email-password" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" autocomplete="current-password" required="" type="password" value=""></div></div><p class="text-2xs text-text-dim">Pedimos tu contraseña porque con el correo se entra en tu cuenta y se recupera. Te enviaremos un enlace a la dirección nueva: el cambio solo se aplica al confirmarlo, y entonces se cerrarán tus sesiones.</p><button type="submit" class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-sm border px-5 text-sm font-semibold transition-[filter,background-color,border-color] duration-150 ease-mechanical disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:brightness-100 disabled:hover:bg-transparent bg-transparent text-text border-line hover:bg-raised w-full">Cambiar mi correo</button></form></section><form novalidate="" class="df-rise rounded-sm border border-line bg-surface/60 p-6 shadow-[var(--df-shadow-md)] backdrop-blur-md"><h2 class="text-sm font-semibold tracking-widest text-text-dim uppercase">Contraseña</h2><div class="mt-4 flex flex-col gap-5"><div class=""><label for="pw-actual" class="mb-1.5 block text-sm font-medium text-text">Contraseña actual</label><div class="relative"><input id="pw-actual" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" autocomplete="current-password" required="" type="password" value=""></div></div><div class=""><label for="pw-nueva" class="mb-1.5 block text-sm font-medium text-text">Nueva contraseña</label><div class="relative"><input id="pw-nueva" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised pr-12 border-line focus:border-text" autocomplete="new-password" required="" minlength="10" placeholder="Mínimo 10 caracteres" type="password" value=""><div class="absolute inset-y-0 right-1.5 flex items-center"><button type="button" aria-label="Mostrar contraseña" class="grid h-8 w-8 place-items-center rounded-xs text-text-dim transition-colors duration-150 ease-mechanical hover:text-text"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><path d="M3 3l18 18"></path><path d="M10.6 6.1A9.6 9.6 0 0 1 12 6c6.5 0 10 6 10 6a15.7 15.7 0 0 1-3.3 3.9M6 6.3A15.8 15.8 0 0 0 2 12s3.5 7 10 7a9.4 9.4 0 0 0 4-.9"></path></svg></button></div></div></div><div class=""><label for="pw-confirmar" class="mb-1.5 block text-sm font-medium text-text">Repite la nueva contraseña</label><div class="relative"><input id="pw-confirmar" class="min-h-[44px] w-full rounded-sm border bg-surface px-3.5 text-base text-text placeholder:text-text-dim focus:bg-raised  border-line focus:border-text" autocomplete="new-password" required="" type="password" value=""></div></div></div><button type="submit" class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-sm border px-5 text-sm font-semibold transition-[filter,background-color,border-color] duration-150 ease-mechanical disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:brightness-100 disabled:hover:bg-transparent bg-action text-void border-transparent hover:brightness-110 mt-5 w-full py-3.5 shadow-[var(--df-cta-lift)]">Cambiar contraseña</button></form></div><div class="mt-8"><button type="button" class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-sm border px-5 text-sm font-semibold transition-[filter,background-color,border-color] duration-150 ease-mechanical disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:brightness-100 disabled:hover:bg-transparent bg-transparent text-text border-transparent hover:bg-raised w-full py-3" aria-busy="false">Cerrar sesión</button></div></div>"`;

