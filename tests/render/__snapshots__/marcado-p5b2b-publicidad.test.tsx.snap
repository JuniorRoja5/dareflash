exports[`/empresa/publicidad/[id] > terminada 1`] = `"<div class="df-rise space-y-6"><div><a class="inline-flex min-h-[44px] items-center text-sm text-text-dim underline underline-offset-2 hover:text-text" href="/empresa/publicidad"><span aria-hidden="true">←&nbsp;</span>Publicidad</a><div class="flex flex-wrap items-center gap-3"><h1 class="min-w-0 text-2xl break-words text-text">Pan de masa madre</h1><span class="rounded-xs border border-line px-2 py-0.5 text-2xs text-text-dim">Terminada</span></div><p class="mt-1 max-w-prose text-sm text-text-dim">La terminaste antes de tiempo. Sus días por venir quedaron libres.</p></div><section aria-labelledby="pieza" class="space-y-2"><h2 id="pieza" class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Así se verá</h2><aside aria-label="Publicidad" data-pieza="campana" data-tarjeta-anuncio="previa" class="@container mx-auto w-full max-w-4xl"><div class="grid overflow-hidden rounded-sm border border-line bg-surface "><div class="flex min-w-0 flex-col gap-4 p-5 @2xl:p-8"><div class="flex min-h-[44px] items-center justify-between gap-3"><span data-etiqueta-anuncio="true" class="rounded-xs border border-line px-2 py-0.5 text-2xs font-semibold tracking-widest text-text uppercase">Publicidad</span></div><p class="font-display font-semibold text-pretty break-words text-text text-xl @2xl:text-3xl">El mejor pan del barrio</p><div class="mt-auto flex flex-wrap items-center justify-between gap-x-4 gap-y-2 pt-2"><p class="min-w-0 truncate text-sm text-text-dim" data-dominio-anuncio="true">bar.test</p><span class="inline-flex min-h-[44px] shrink-0 items-center rounded-sm border border-line bg-raised px-5 text-sm font-semibold text-text hover:border-text-dim" aria-disabled="true">Visitar<span aria-hidden="true" class="ml-1.5">↗</span></span></div></div></div></aside><p class="max-w-prose text-2xs break-words text-text-dim">Lleva a <span class="text-text">https://bar.test</span></p></section><div class="grid gap-6 lg:grid-cols-2 lg:items-start lg:gap-8"><div class="min-w-0 space-y-6"><div class="rounded-sm border border-line bg-surface p-4 p-5"><h2 class="text-2xs font-semibold tracking-widest text-text-dim uppercase">La campaña</h2><dl class="mt-3 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2"><div><dt class="text-2xs text-text-dim">Alcance</dt><dd class="text-text">Todo el mundo</dd></div><div><dt class="text-2xs text-text-dim">Zona</dt><dd class="break-words text-text">Sevilla y 100 km alrededor</dd></div><div><dt class="text-2xs text-text-dim">Días</dt><dd class="text-text tabular-nums">11 nov – 14 nov 2026</dd></div><div><dt class="text-2xs text-text-dim">Créditos por día</dt><dd class="text-text tabular-nums">1</dd></div></dl><p class="mt-3 text-2xs text-text-dim">Cada día de campaña empieza a la 1:00, hora de Madrid.</p></div></div><div class="min-w-0 space-y-6"></div></div><section aria-labelledby="resultados" class="space-y-3"><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><h2 id="resultados" class="text-base font-semibold text-text">Resultados</h2><p class="mt-1 max-w-prose text-sm text-text-dim">Veces que se mostró: las veces que la pusimos en el feed o en la portada. Clics: las veces que alguien la tocó para ir a tu web. Se actualizan cada 10 minutos.</p><dl class="mt-4 grid grid-cols-3 gap-3"><div class="rounded-sm border border-line bg-surface p-3"><dt class="text-2xs text-text-dim">Veces que se mostró</dt><dd class="mt-1 text-xl font-semibold text-text tabular-nums">1234</dd></div><div class="rounded-sm border border-line bg-surface p-3"><dt class="text-2xs text-text-dim">Clics</dt><dd class="mt-1 text-xl font-semibold text-text tabular-nums">25</dd></div><div class="rounded-sm border border-line bg-surface p-3"><dt class="text-2xs text-text-dim">Clics por cada 100 veces que se mostró</dt><dd class="mt-1 text-xl font-semibold text-text tabular-nums">2,0</dd></div></dl><p class="mt-4 max-w-prose text-sm text-text-dim">Todavía no hay cifras. Aparecen en cuanto la campaña empieza a mostrarse.</p></div></section></div>"`;

exports[`/empresa/publicidad/nueva > con un tipo de negocio fuera del catálogo 1`] = `"<div class="df-rise space-y-6"><div><a class="inline-flex min-h-[44px] items-center text-sm text-text-dim underline underline-offset-2 hover:text-text" href="/empresa/publicidad"><span aria-hidden="true">←&nbsp;</span>Publicidad</a><h1 class="text-2xl text-text">Nueva campaña</h1><p class="mt-1 max-w-prose text-sm text-text-dim">Un día de campaña cuesta 1 crédito en una ciudad y 15 en todo el mundo, y se descuenta cada día que se muestra. Sin revisión previa: la activas tú.</p></div><div class="rounded-sm border border-line bg-surface p-4 max-w-prose p-5"><p class="text-sm text-text-dim">No podemos ofrecerte campañas hasta revisar el tipo de negocio de tu empresa. Escríbenos contestando a cualquiera de nuestros correos y lo arreglamos.</p></div></div>"`;

