exports[`/empresa/publicidad/[id] > el informe vacío en una página posterior 1`] = `"<section aria-labelledby="resultados" class="space-y-3"><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><h2 id="resultados" class="text-base font-semibold text-text">Resultados</h2><p class="mt-1 max-w-prose text-sm text-text-dim">Veces que se mostró: las veces que la pusimos en el feed o en la portada. Clics: las veces que alguien la tocó para ir a tu web. Se actualizan cada 10 minutos.</p><dl class="mt-4 grid grid-cols-3 gap-3"><div class="rounded-sm border border-line bg-surface p-3"><dt class="text-2xs text-text-dim">Veces que se mostró</dt><dd class="mt-1 text-xl font-semibold text-text tabular-nums">1234</dd></div><div class="rounded-sm border border-line bg-surface p-3"><dt class="text-2xs text-text-dim">Clics</dt><dd class="mt-1 text-xl font-semibold text-text tabular-nums">25</dd></div><div class="rounded-sm border border-line bg-surface p-3"><dt class="text-2xs text-text-dim">Clics por cada 100 veces que se mostró</dt><dd class="mt-1 text-xl font-semibold text-text tabular-nums">2,0</dd></div></dl><p class="mt-4 max-w-prose text-sm text-text-dim">No hay días más antiguos.</p></div><nav aria-label="Paginación" class="mt-6 flex items-center justify-between gap-3"><a rel="prev" class="inline-flex min-h-[44px] items-center gap-1.5 rounded-sm border border-line px-4 text-sm font-medium text-text transition-colors duration-[var(--df-dur-fast)] ease-mechanical hover:bg-raised lg:min-h-[38px]" href="/empresa/publicidad/campana0000001"><span aria-hidden="true">←</span> Anterior</a><span></span></nav></section>"`;

exports[`/empresa/publicidad/[id] > en revisión, sin datos 1`] = `"<div class="df-rise space-y-6"><div><a class="inline-flex min-h-[44px] items-center text-sm text-text-dim underline underline-offset-2 hover:text-text" href="/empresa/publicidad"><span aria-hidden="true">←&nbsp;</span>Publicidad</a><div class="flex flex-wrap items-center gap-3"><h1 class="min-w-0 text-2xl break-words text-text">Pan de masa madre</h1><span class="rounded-xs border border-line px-2 py-0.5 text-2xs text-text-dim">En revisión</span></div><p class="mt-1 max-w-prose text-sm text-text-dim">La hemos pausado mientras revisamos unas denuncias. Sus días por venir quedaron libres y no se te descuenta nada. Te escribiremos cuando lo hayamos decidido.</p></div><section aria-labelledby="pieza" class="space-y-2"><h2 id="pieza" class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Así se verá</h2><aside aria-label="Publicidad" data-pieza="campana" data-tarjeta-anuncio="previa" class="@container mx-auto w-full max-w-4xl"><div class="grid overflow-hidden rounded-sm border border-line bg-surface "><div class="flex min-w-0 flex-col gap-4 p-5 @2xl:p-8"><div class="flex min-h-[44px] items-center justify-between gap-3"><span data-etiqueta-anuncio="true" class="rounded-xs border border-line px-2 py-0.5 text-2xs font-semibold tracking-widest text-text uppercase">Publicidad</span></div><p class="font-display font-semibold text-pretty break-words text-text text-xl @2xl:text-3xl">El mejor pan del barrio</p><div class="mt-auto flex flex-wrap items-center justify-between gap-x-4 gap-y-2 pt-2"><p class="min-w-0 truncate text-sm text-text-dim" data-dominio-anuncio="true">bar.test</p><span class="inline-flex min-h-[44px] shrink-0 items-center rounded-sm border border-line bg-raised px-5 text-sm font-semibold text-text hover:border-text-dim" aria-disabled="true">Visitar<span aria-hidden="true" class="ml-1.5">↗</span></span></div></div></div></aside><p class="max-w-prose text-2xs break-words text-text-dim">Lleva a <span class="text-text">https://bar.test</span></p></section><div class="grid gap-6 lg:grid-cols-2 lg:items-start lg:gap-8"><div class="min-w-0 space-y-6"><div class="rounded-sm border border-line bg-surface p-4 p-5"><h2 class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Cuánta gente la verá</h2><p class="mt-2 text-sm text-text">Todavía no tenemos datos de Andalucía: no podemos decirte cuánta gente la verá.</p><p class="mt-2 text-2xs text-text-dim">Calculado con la gente que ha pasado por el feed en tu zona los últimos días, el peor día de tus fechas y redondeado a la baja.</p></div><div class="rounded-sm border border-line bg-surface p-4 p-5"><h2 class="text-2xs font-semibold tracking-widest text-text-dim uppercase">La campaña</h2><dl class="mt-3 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2"><div><dt class="text-2xs text-text-dim">Alcance</dt><dd class="text-text">Una región entera</dd></div><div><dt class="text-2xs text-text-dim">Zona</dt><dd class="break-words text-text">Sevilla y 100 km alrededor</dd></div><div><dt class="text-2xs text-text-dim">Días</dt><dd class="text-text tabular-nums">18 nov – 24 nov 2026</dd></div><div><dt class="text-2xs text-text-dim">Créditos por día</dt><dd class="text-text tabular-nums">1</dd></div><div class="sm:col-span-2"><dt class="text-2xs text-text-dim">Le quedan</dt><dd class="text-text tabular-nums"><span class="font-semibold">4 créditos</span> (4 días)</dd></div></dl><p class="mt-3 text-2xs text-text-dim">Cada día de campaña empieza a la 1:00, hora de Madrid.</p></div></div><div class="min-w-0 space-y-6"><div class="rounded-sm border border-line bg-surface p-4 p-5"><h2 class="text-2xs font-semibold tracking-widest text-text-dim uppercase">Qué quieres hacer</h2><div class="mt-3"><div class="space-y-3"><div class="flex flex-wrap gap-2"><button type="button" class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-sm border px-5 text-sm font-semibold transition-[filter,background-color,border-color] duration-150 ease-mechanical disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:brightness-100 disabled:hover:bg-transparent bg-transparent text-text border-transparent hover:bg-raised w-full sm:w-auto">Terminar ya</button></div></div></div></div></div></div><section aria-labelledby="resultados" class="space-y-3"><div class="rounded-sm border border-line bg-surface p-4 p-5 lg:p-6"><h2 id="resultados" class="text-base font-semibold text-text">Resultados</h2><p class="mt-1 max-w-prose text-sm text-text-dim">Veces que se mostró: las veces que la pusimos en el feed o en la portada. Clics: las veces que alguien la tocó para ir a tu web. Se actualizan cada 10 minutos.</p><dl class="mt-4 grid grid-cols-3 gap-3"><div class="rounded-sm border border-line bg-surface p-3"><dt class="text-2xs text-text-dim">Veces que se mostró</dt><dd class="mt-1 text-xl font-semibold text-text tabular-nums">1234</dd></div><div class="rounded-sm border border-line bg-surface p-3"><dt class="text-2xs text-text-dim">Clics</dt><dd class="mt-1 text-xl font-semibold text-text tabular-nums">25</dd></div><div class="rounded-sm border border-line bg-surface p-3"><dt class="text-2xs text-text-dim">Clics por cada 100 veces que se mostró</dt><dd class="mt-1 text-xl font-semibold text-text tabular-nums">2,0</dd></div></dl><p class="mt-4 max-w-prose text-sm text-text-dim">Todavía no hay cifras. Aparecen en cuanto la campaña empieza a mostrarse.</p></div></section></div>"`;

