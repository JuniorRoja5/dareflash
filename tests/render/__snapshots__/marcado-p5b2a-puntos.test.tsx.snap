m] text-center text-2xs text-text-dim lg:text-right">O que lo escaneen desde tu pantalla</p></div></div></section><div class="mt-6 grid gap-3 sm:grid-cols-3"><div class="relative overflow-hidden rounded-sm border border-line bg-surface/60 p-4 shadow-[var(--df-shadow-sm)] backdrop-blur-md"><div class="relative flex items-start gap-3"><div class="min-w-0 flex-1"><p class="text-2xs tracking-widest text-text-dim uppercase">Invitados</p><p class="mt-1.5 text-3xl leading-none font-semibold tabular-nums text-text">2</p></div></div></div><div class="relative overflow-hidden rounded-sm border border-line bg-surface/60 p-4 shadow-[var(--df-shadow-sm)] backdrop-blur-md"><div class="relative flex items-start gap-3"><div class="min-w-0 flex-1"><p class="text-2xs tracking-widest text-text-dim uppercase">Puntos ganados</p><p class="mt-1.5 text-3xl leading-none font-semibold tabular-nums text-text">50</p><p class="mt-2 text-2xs text-text-dim">Por invitaciones que ya verificaron</p></div></div></div><div class="relative overflow-hidden rounded-sm border border-line bg-surface/60 p-4 shadow-[var(--df-shadow-sm)] backdrop-blur-md"><div class="relative flex items-start gap-3"><div class="min-w-0 flex-1"><p class="text-2xs tracking-widest text-text-dim uppercase">Pendientes de verificar</p><p class="mt-1.5 text-3xl leading-none font-semibold tabular-nums text-text">1</p><p class="mt-2 text-2xs text-text-dim">Todavía no te han dado puntos</p></div></div></div></div><div class="mt-10"><section aria-labelledby="historial"><h2 id="historial" class="text-sm font-semibold tracking-widest text-text-dim uppercase">A quién has invitado</h2><ul class="mt-4 divide-y divide-line overflow-hidden rounded-sm border border-line bg-surface/60 shadow-[var(--df-shadow-sm)] backdrop-blur-md"><li data-referido="r1" class="flex flex-wrap items-center gap-3 p-4 transition-colors duration-[var(--df-dur-fast)] ease-mechanical hover:bg-raised/60"><span class="relative inline-flex shrink-0 h-8 w-8"><span aria-hidden="true" class="inline-flex h-8 w-8 text-xs shrink-0 items-center justify-center overflow-hidden rounded-full bg-raised font-semibold text-text-dim" style="box-shadow: 0 0 0 2px var(--df-nivel-challenger);" data-nivel="challenger">B</span><svg viewBox="0 0 24 24" role="img" aria-label="Nivel Challenger" class="pointer-events-none absolute h-3.5 w-3.5 -right-0.5 -bottom-0.5" style="color: var(--df-nivel-challenger);"><circle cx="12" cy="12" r="12" fill="currentColor"></circle><g fill="var(--df-void)"><path d="M10.2 16.6L6 12.4l1.7-1.7 2.5 2.5 6.1-6.1L18 8.8z"></path></g></svg></span><span class="min-w-0 flex-1"><span class="block truncate text-sm font-medium text-text">Bea</span><span class="block truncate text-2xs text-text-dim">Se unió el 1/3/2026</span></span><span class="shrink-0 rounded-xs bg-raised px-2 py-1 text-sm font-medium tabular-nums text-text">+50 ganados</span></li><li data-referido="r2" class="flex flex-wrap items-center gap-3 p-4 transition-colors duration-[var(--df-dur-fast)] ease-mechanical hover:bg-raised/60"><span aria-hidden="true" class="inline-flex h-8 w-8 text-xs shrink-0 items-center justify-center overflow-hidden rounded-full bg-raised font-semibold text-text-dim">C</span><span class="min-w-0 flex-1"><span class="inline-flex min-w-0 max-w-full items-center gap-1.5 align-bottom block truncate text-sm font-medium text-text"><span class="df-nombre-vip truncate">cai</span><span data-marca-vip="compacta" aria-label="VIP Mythic" title="VIP Mythic" role="img" class="inline-flex shrink-0 items-center justify-center bg-[var(--vip-gold)] font-black tracking-[0.04em] text-[var(--vip-tinta)] tabular-nums px-1 py-px text-[9px] rounded-[4px] " style="font-family: var(--font-display); line-height: 1;">VIP</span></span><span class="block truncate text-2xs text-text-dim">Se unió el 28/2/2026</span></span><span class="shrink-0 text-2xs text-text-dim">Pendiente de verificar</span></li></ul><nav aria-label="Paginación" class="mt-6 flex items-center justify-between gap-3"><span></span><a rel="next" class="inline-flex min-h-[44px] items-center gap-1.5 rounded-sm border border-line px-4 text-sm font-medium text-text transition-colors duration-[var(--df-dur-fast)] ease-mechanical hover:bg-raised lg:min-h-[38px]" href="/referidos?cursor=c2">Siguiente <span aria-hidden="true">→</span></a></nav><p class="mt-6 text-2xs text-text-dim">Invitar es una de las formas de ganar puntos. <a class="underline underline-offset-2 hover:text-text" href="/puntos">Ver todas y tu nivel</a>.</p></section></div></div>"`;

exports[`/referidos > sin enlace (no se pudo cargar el código) 1`] = `"<div class="df-rise mx-auto w-full max-w-5xl px-4 py-8 lg:px-8 lg:py-12"><section aria-labelledby="invitar" style="--df-halo-color: var(--df-action);" class="relative overflow-hidden rounded-sm border border-line bg-surface/60 p-6 shadow-[var(--df-shadow-md)] backdrop-blur-md lg:p-10"><span class="df-halo" aria-hidden="true"></span><div class="relative grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start lg:gap-12"><div class="min-w-0"><h1 id="invitar" class="text-[clamp(1.75rem,5vw,2.75rem)] leading-[1.05] text-text" style="font-family: var(--font-display); font-variation-settings: &quot;wght&quot; 800, &quot;wdth&quot; 110;">Invita y gana puntos</h1><p class="mt-3 max-w-prose text-sm text-text-dim">Ganas <strong class="font-semibold text-text">50 puntos</strong> cuando tu invitado verifica su correo. Tu invitado gana otros tantos.</p><p class="mt-7 rounded-sm border border-line bg-raised p-4 text-sm text-text-dim">No hemos podido cargar tu enlace. Recarga la página.</p></div></div></section><div class="mt-6 grid gap-3 sm:grid-cols-3"><div class="relative overflow-hidden rounded-sm border border-line bg-surface/60 p-4 shadow-[var(--df-shadow-sm)] backdrop-blur-md"><div class="relative flex items-start gap-3"><div class="min-w-0 flex-1"><p class="text-2xs tracking-widest text-text-dim uppercase">Invitados</p><p class="mt-1.5 text-3xl leading-none font-semibold tabular-nums text-text">0</p></div></div></div><div class="relative overflow-hidden rounded-sm border border-line bg-surface/60 p-4 shadow-[var(--df-shadow-sm)] backdrop-blur-md"><div class="relative flex items-start gap-3"><div class="min-w-0 flex-1"><p class="text-2xs tracking-widest text-text-dim uppercase">Puntos ganados</p><p class="mt-1.5 text-3xl leading-none font-semibold tabular-nums text-text">0</p><p class="mt-2 text-2xs text-text-dim">Por invitaciones que ya verificaron</p></div></div></div><div class="relative overflow-hidden rounded-sm border border-line bg-surface/60 p-4 shadow-[var(--df-shadow-sm)] backdrop-blur-md"><div class="relative flex items-start gap-3"><div class="min-w-0 flex-1"><p class="text-2xs tracking-widest text-text-dim uppercase">Pendientes de verificar</p><p class="mt-1.5 text-3xl leading-none font-semibold tabular-nums text-text">0</p></div></div></div></div><div class="mt-10"><section aria-labelledby="historial"><h2 id="historial" class="text-sm font-semibold tracking-widest text-text-dim uppercase">A quién has invitado</h2><p class="mt-4 rounded-sm border border-line bg-surface/40 p-6 text-sm text-text-dim">Todavía no se ha registrado nadie con tu enlace. Compártelo y aparecerán aquí.</p><p class="mt-6 text-2xs text-text-dim">Invitar es una de las formas de ganar puntos. <a class="underline underline-offset-2 hover:text-text" href="/puntos">Ver todas y tu nivel</a>.</p></section></div></div>"`;

