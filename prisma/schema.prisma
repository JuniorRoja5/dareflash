// DareFlash — esquema nucleo (Paso 4).
// Motor: MariaDB 11.8 (local y produccion). Prisma usa `provider = "mysql"`,
// que es lo correcto tambien para MariaDB.
//
// Convenciones NO negociables (documento de arquitectura, secciones 6-8):
//   - Dinero SIEMPRE en enteros (centimos). Nunca coma flotante.
//   - Ledgers de SOLO-INSERCION: una fila por movimiento, jamas se edita/borra.
//   - Todo en UTC. La zona horaria solo al presentar.
//   - Char(3) para `currency`; existe desde el dia 1 aunque haya una sola moneda.
//
// ESTADOS COMO String (hibrido): los estados fluidos (Job, Report, WalletLedger,
// Challenge, Boost...) son String en la BD para no forzar una migracion por cada
// estado nuevo, PERO estan tipados y validados con Zod en `src/config/constants.ts`
// (uniones z.enum). Asi un "PENDNIG" mal escrito lo rechaza la validacion antes de
// tocar la base de datos. Enums de Prisma de verdad solo en `Role` y
// `ModerationStatus`, que son conjuntos estables y sensibles.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // Prisma 7: la URL ya NO va aqui. Para migraciones la lee prisma.config.ts;
  // en runtime el cliente se conecta con un driver adapter (@prisma/adapter-mariadb),
  // que ademas elimina el binario nativo del motor de consultas (usa queryCompiler WASM).
  provider = "mysql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

/// Estados de moderacion de contenido (Video y Submission).
/// Nunca hay borrado fisico de contenido denunciado: REMOVED es un estado.
/// FAILED: terminal e INVISIBLE, lo fija el sondeo de confirmacion (worker) cuando Bunny no deja
/// publicable el video (error de transcodificado o supera 90 s; el motivo va en Video.failureReason).
/// NO es una decision de moderacion; el poller es forward-only (solo promueve PENDING).
enum ModerationStatus {
  PENDING
  PUBLISHED
  REJECTED
  REMOVED
  FAILED
}

// ============================================================================
// AUTENTICACION (Auth.js v5 + @auth/prisma-adapter) + PERFIL
// ============================================================================

model User {
  id String @id @default(cuid())

  // --- Identidad / perfil ---
  // UNICIDAD SIN DISTINGUIR MAYUSCULAS (INTENCIONADO): la collation por defecto es
  // utf8mb4_unicode_ci, asi que estos UNIQUE colisionan "Junior" con "junior" y
  // "A@x.com" con "a@x.com". Es lo deseable para handles y correos (evita
  // suplantaciones por diferencia de mayusculas). Se asume y se deja escrito.
  email         String?   @unique // opcional a nivel Auth.js; en registro propio se exige
  emailVerified DateTime? // Auth.js: fecha de verificacion. Sin esto no hay acciones con efectos.
  username      String    @unique // handle publico, SIEMPRE presente (auto-generado; ver server/auth/handle.ts)
  displayName   String?
  image         String? // avatar (URL)
  bio           String?   @db.Text
  // Enlaces de perfil v1. `website` es una URL http/https libre (se pinta con rel="nofollow noopener").
  // `instagram`/`youtube` guardan el HANDLE, no una URL: evita que alguien meta un enlace malicioso
  // disfrazado de red social; el frontend construye la URL a partir del handle (validado en servidor).
  website       String?
  instagram     String? // handle de Instagram (sin @, sin URL)
  youtube       String? // handle de YouTube (con o sin @, sin URL)

  // --- Credenciales propias (email/contrasena). OAuth va por Account. ---
  passwordHash String? @db.Text // Argon2id. Null si el usuario solo usa OAuth.

  // --- Autorizacion y cumplimiento ---
  role Role @default(USER)

  // Permiso de CREAR RETOS concedido por-usuario (Fase 2). Hoy solo el ADMIN crea; este flag deja
  // habilitar a usuarios concretos SIN tocar codigo. La DECISION vive en UN solo sitio:
  // `usuarioPuedeCrearRetos` (src/lib/permisos.ts) = role ADMIN || este flag. Prohibido cablear
  // `role === "ADMIN"` en otro lado.
  puedeCrearRetos Boolean @default(false)

  // NULLABLE a proposito: el adaptador de Auth.js crea el usuario en el alta por
  // OAuth (Google) con lo que da el proveedor (email, nombre, imagen), y Google NO
  // devuelve fecha de nacimiento. Si fuera obligatoria, el alta con Google fallaria.
  // La edad minima 16 NO se relaja: se exige en la CAPA DE APLICACION. Tras el alta
  // por OAuth el usuario pasa por "completar perfil"; sin `birthDate` verificada no
  // puede realizar ninguna accion con efectos (participar, votar, cobrar).
  birthDate DateTime?

  // --- Saldos DENORMALIZADOS (cache guardado por transaccion + FOR UPDATE). ---
  // La verdad contable es la suma del ledger; estas columnas son un cache que se
  // actualiza en la MISMA transaccion que la insercion del movimiento, bloqueando
  // esta fila con SELECT ... FOR UPDATE. Un job (LEDGER_RECONCILE) verifica que
  // cuadren con la suma del ledger y alerta si no.
  //
  // La MONEDA del monedero NO se guarda aqui: es unica para toda la app y vive en
  // `DEFAULT_CURRENCY` (constants). Multi-moneda futura necesitaria una tabla
  // `WalletAccount` por (usuario, moneda). Cada fila de WalletLedger si guarda su
  // `currency` para auditoria. INVARIANTE asociado: todas las filas de WalletLedger
  // de un usuario comparten `currency` (ver WalletLedger; lo vigila LEDGER_RECONCILE).
  //
  // Los TRES saldos reciben el mismo trato: nunca un UPDATE suelto sin insertar su
  // fila de ledger (PointsLedger / WalletLedger / BoostLedger), siempre dentro de la
  // misma transaccion con SELECT ... FOR UPDATE sobre esta fila, y LEDGER_RECONCILE
  // comprueba periodicamente que cada saldo == SUM(delta) de su ledger.
  pointsBalance      Int @default(0) // puntos (DareUp). Nunca negativo por diseno.
  walletBalanceCents Int @default(0) // dinero en centimos (moneda unica de la app).
  boostBalance       Int @default(0) // creditos de Boost disponibles (ver BoostLedger).

  // --- Busqueda (A1) ---
  // SCORE DE AUTORIDAD para ORDENAR resultados de busqueda. Cache DENORMALIZADO e INDEXADO que el
  // WORKER recalcula en barridos de baja cadencia (nunca al vuelo; la busqueda solo LEE esta columna).
  // Punto UNICO de calculo: `calcularScoreAutoridad`. HOY combina senales existentes (nº de videos
  // publicados + recencia); Fase 3 sumara votos, Fase 4 nivel/puntos/likes.
  scoreAutoridad Int @default(0)

  // --- Ciclo de vida (RGPD). ---
  // SOFT DELETE + ANONIMIZACION: al borrar una cuenta NO se borran filas de
  // ledger/voto (son registro contable/antifraude, y ademas no tienen FK). El
  // servicio de anonimizacion, en una transaccion:
  //   1. Pone `deletedAt = now()`.
  //   2. Pone a NULL los datos personales y el UNIQUE de email:
  //      email, displayName, image, bio, passwordHash, birthDate.
  //      (email DEBE quedar a NULL o la direccion quedaria ocupada para siempre y la
  //       persona no podria volver a registrarse; el registro es POR EMAIL.)
  //      username NO puede ir a NULL (columna NOT NULL): se sustituye por un TOMBSTONE
  //      neutro (p.ej. `del_<aleatorio>`, formato `^[a-z0-9._]{3,30}$`) que libera el
  //      handle humano para reuso sin dejar el campo vacio. NO poner username = NULL.
  //   3. Los ledgers/votos conservan su `userId` (huerfano, sin FK): la contabilidad
  //      queda integra pero desvinculada de la identidad.
  deletedAt DateTime? // soft delete
  bannedAt  DateTime? // baneo de moderacion

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones con FK (datos propios del usuario). Los ledgers/votos/auditoria/boost
  // NO llevan FK a proposito (ver su comentario): deben sobrevivir "desvinculados"
  // a la anonimizacion o a un borrado duro del usuario.
  accounts    Account[]
  sessions    Session[]
  videos      Video[]
  challenges  Challenge[]  @relation("ChallengeCreatedBy")
  submissions Submission[]

  @@index([role])
  @@index([deletedAt])
  @@index([scoreAutoridad]) // orden por autoridad en la busqueda (keyset: scoreAutoridad DESC, id)
  @@index([displayName]) // btree para prefijo izquierda-anclado (displayName LIKE 'x%') indexado
  @@fulltext([username, displayName]) // busqueda de usuarios por texto (MATCH..AGAINST)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique // aqui va el HASH SHA-256 del token, no el token
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now()) // para el tope por usuario (borrar la mas antigua) y "ultima sesion"

  /// ULTIMA VEZ que se USO esta sesion. Es lo que permite la caducidad por INACTIVIDAD, que es
  /// distinta de `expires` (el tope absoluto): una sesion abandonada en un ordenador ajeno seguia
  /// valiendo semanas aunque nadie la tocara. Se refresca de forma AMORTIGUADA (ver
  /// SESION_REFRESCO_MIN_MS): escribir en cada peticion multiplicaria por N las escrituras.
  lastSeenAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt]) // tope por usuario, ordenado por antiguedad
  @@index([expires]) // purga de caducadas (purgeExpiredSessions) sin recorrer la tabla
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  /// PROPOSITO del token: "EMAIL_VERIFY" (verificacion de alta) o "LOGIN_UNLOCK" (desbloqueo del
  /// cubo de cuenta por correo). Se comprueba DENTRO del WHERE al consumir, NUNCA despues de
  /// encontrar el token: asi un token de verificacion no puede desbloquear una cuenta ni al reves
  /// (imposible por construccion, no una regla que alguien pueda saltarse). Default para las filas
  /// existentes al migrar. Union validada con Zod en constants (VerificationPurposeSchema).
  purpose String @default("EMAIL_VERIFY")

  @@unique([identifier, token])
}

// ============================================================================
// CONTENIDO: VIDEO, CHALLENGE, SUBMISSION
// ============================================================================

/// Un video subido a Bunny.net. Nunca pasan bytes por nuestro servidor: solo
/// guardamos el id de Bunny y metadatos.
model Video {
  id           String           @id @default(cuid())
  userId       String
  bunnyVideoId String           @unique // referencia en Bunny
  status       ModerationStatus @default(PENDING)
  durationSec  Int? // duracion validada EN SERVIDOR al confirmar (nunca fiarse del cliente)
  // Motivo cuando status=FAILED. String tipado con Zod (VideoFailureReasonSchema), no enum de
  // Prisma: TRANSCODE_ERROR | TOO_LONG. Distingue el fallo tecnico de la sobreduracion.
  failureReason String?
  title         String?

  // NOMBRE del fichero de miniatura EN BUNNY. Bunny NO sirve siempre la miniatura como
  // `thumbnail.jpg`: ese es el frame AUTOMATICO que extrae al transcodificar. Cuando el dueno sube
  // una miniatura PERSONALIZADA, Bunny la guarda con un nombre propio (p.ej.
  // `thumbnail_eaffe862.jpg`) y lo publica en el campo `thumbnailFileName` de su API; `thumbnail.jpg`
  // sigue existiendo con el frame automatico. Verificado contra la biblioteca real.
  //
  // NULL = no sabemos de ninguna personalizada -> se usa `thumbnail.jpg` (correcto para todo video
  // sin miniatura propia, que es la inmensa mayoria). Por eso la columna es NULLABLE y NO necesita
  // backfill: el valor ausente YA significa lo correcto.
  //
  // Se guarda porque hay que construir la URL del poster en CADA render de feed/perfil/rejilla, y
  // preguntarselo a Bunny por video y por render seria inviable.
  thumbnailFileName String?

  // CATEGORIA de un video LIBRE (Fase 2, subida sin reto): key de CATEGORIES. NULL en las
  // participaciones (su categoria es la del RETO, via Submission->Challenge: fuente unica, NO se
  // duplica aqui) y en videos libres antiguos (sin backfill). La resolucion de feed/perfil: con
  // Submission publicada -> categoria del reto; sin Submission -> este campo.
  category String?

  // REEMPLAZO en vuelo (Fase 2). Un Video de reemplazo apunta a la Submission que sustituira: se crea
  // SIN Submission propia (respeta el @@unique([challengeId,userId])). Mientras este seteado, el video
  // NO aparece en el feed; cuando pasa a PUBLISHED, el SWAP (cliente o worker) repunta esa Submission a
  // este video, marca el video viejo REMOVED (+ encola su borrado en Bunny) y limpia este puntero. NULL
  // = video normal (subida libre o primera participacion). SIN FK: el swap comprueba la fila a mano y
  // un reemplazo abandonado se recupera por el worker.
  reemplazaSubmissionId String?

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  submission Submission? // un video se usa en como mucho una submission

  @@index([userId])
  @@index([status])
  // El worker completa reemplazos abandonados: busca PUBLISHED con este puntero seteado.
  @@index([reemplazaSubmissionId])
}

/// Un reto. Pieza central del producto: tiene PREMIO. Lo sensible al tiempo se
/// resuelve por consulta sobre `deadline` (calculado, no disparado): el cierre real
/// es "status=PUBLISHED AND deadline <= now()", y el job solo consolida.
model Challenge {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text
  category    String // key de CATEGORIES en constants (las 14 confirmadas por el propietario)
  status      String  @default("DRAFT") // DRAFT, PUBLISHED, CLOSED (union en constants)

  /// BORRADO POR EL ADMIN, en dos tiempos y SIN destruir nada.
  ///
  /// `eliminacionProgramadaEn`: el admin pidio borrarlo y corre una GRACIA (7 dias) para
  /// arrepentirse. El reto desaparece del PUBLICO ya, pero sigue en el panel con su cuenta atras y se
  /// puede RESTAURAR. `deletedAt`: ya esta borrado (por el barrido al vencer el plazo, o porque el
  /// admin lo forzo). En los dos casos sale de todas las vistas publicas.
  ///
  /// NUNCA hay borrado FISICO. Primero porque la FK de Submission es `onDelete: Restrict`: un reto con
  /// participaciones no se puede borrar sin destruir ANTES el contenido de sus usuarios. Y sobre todo
  /// porque destruir los videos de terceros como efecto colateral de que un admin borre un reto es
  /// exactamente el riesgo que la gracia de 7 dias pretende cubrir. Los videos siguen siendo de sus
  /// autores y siguen en su perfil; lo que desaparece es el RETO.
  eliminacionProgramadaEn DateTime?
  deletedAt               DateTime?

  // --- URL del reto (Fase 2): /retos/{publicCode}-{slug} ---
  // publicCode: clave AUTORITATIVA, corta y UNICA (base32 sin confusos, generada con reintento; ver
  // server/services/reto-codigo). slug: COSMETICO (SEO), NO unico; el route de detalle resuelve por
  // publicCode y hara 301 al canonico si el slug no cuadra (trabajo posterior).
  slug       String
  publicCode String @unique

  // Portada OPCIONAL subida por el admin al crear (Fase 2). URL publica servida por Caddy desde el
  // volumen `portadas_data` (/portadas/{publicCode}.webp?v=...), mismo patron que el avatar. NULL = sin
  // portada -> la tarjeta usa el placeholder. Sin edicion tras crear (futuro).
  coverImage String?

  // Reglas del reto en campo PROPIO, separado de description (que es la presentacion/gancho).
  rules String? @db.Text

  // Nº de ganadores configurable por reto (dominio: >= 1; lo valida el schema de creacion futuro).
  winnersCount Int @default(1)

  // Premio en enteros (centimos) desde el dia 1: si entrara mas tarde, alguien lo
  // meteria como decimal. 0 = aun sin premio. La moneda la fija la app desde
  // DEFAULT_CURRENCY (constants); no se incrusta como default del esquema.
  prizeAmountCents Int    @default(0)
  prizeCurrency    String @db.Char(3)

  startsAt    DateTime // apertura (UTC)
  deadline    DateTime // cierre (UTC)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Busqueda (A1): score de autoridad DENORMALIZADO e INDEXADO, recalculado por el worker (nunca al
  // vuelo). HOY: premio + proximidad de deadline + activo>cerrado. Ver User.scoreAutoridad y
  // `calcularScoreAutoridad` (punto unico de calculo).
  scoreAutoridad Int @default(0)

  createdBy   User              @relation("ChallengeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  submissions Submission[]
  results     ChallengeResult[]

  @@index([category])
  @@index([status, deadline]) // retos vigentes / a cerrar, calculado por consulta
  @@index([createdById])
  @@index([scoreAutoridad]) // orden por autoridad en la busqueda (keyset)
  // btree para prefijo izquierda-anclado (title LIKE 'x%') indexado. Nombre EXPLICITO para no chocar
  // con el FULLTEXT (que Prisma nombraria igual, `Challenge_title_idx`).
  @@index([title], map: "Challenge_title_btree_idx")
  @@fulltext([title]) // busqueda de retos por texto (MATCH..AGAINST)
}

/// Participacion de un usuario en un reto, enlazando un video.
///
/// FUENTE DE VERDAD DEL ESTADO (Video.status vs Submission.status): mandan LOS DOS,
/// el mas restrictivo gana. `Video.status` es la verdad del MEDIO en si (si el video
/// esta REJECTED/REMOVED, no se muestra en ningun sitio). `Submission.status` gobierna
/// la visibilidad de ESA participacion en el reto (se puede retirar una submission sin
/// tocar el video, que puede seguir en el feed). Una submission es visible/valida solo
/// si `Submission.status = PUBLISHED` Y `Video.status = PUBLISHED`. Si divergen, el
/// estado mas restrictivo decide (un video REMOVED oculta la submission aunque su
/// propio status siga PUBLISHED).
/// POR QUE se retiro una participacion. `null` = no esta retirada.
///
/// Existe porque las dos retiradas tienen consecuencias OPUESTAS y antes se deducian del mismo
/// `ModerationStatus.REMOVED`, que no puede distinguirlas:
///   - MODERACION: la retiro un admin -> el usuario NO puede volver a participar en ese reto.
///   - DUENO: el propio usuario borro su video -> SI puede volver a participar; es SU contenido.
/// Deducirlo del status vetaba de por vida a quien borraba su propio video, con un mensaje que ademas
/// mentia ("retirada por moderacion"). Con este campo el estado "no se sabe cual de las dos fue" es
/// IRREPRESENTABLE: o hay motivo, o no esta retirada.
enum MotivoRetirada {
  MODERACION
  DUENO
}

model Submission {
  id          String           @id @default(cuid())
  challengeId String
  userId      String
  videoId     String           @unique // un video, una submission
  status      ModerationStatus @default(PENDING)

  /// Por que se retiro (ver `MotivoRetirada`). `null` = viva. Es la UNICA fuente para decidir si el
  /// usuario puede volver a participar: la regla NO mira `status` ni el estado del Video, que son
  /// ambiguos. Va junto a `retiradaEn` para poder auditar cuando ocurrio.
  retiradaMotivo MotivoRetirada?
  retiradaEn     DateTime?

  // voteCount DENORMALIZADO: se actualiza en la MISMA transaccion que la
  // insercion del Vote (mismo patron que los saldos). Permite ORDER BY para
  // rankings sin contar filas, y un job lo reconcilia contra COUNT(Vote).
  voteCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  video     Video     @relation(fields: [videoId], references: [id], onDelete: Restrict)
  // `Vote` NO tiene relacion formal (sin FK, desacoplado como los ledgers). Los
  // votos de una submission se consultan por `submissionId` (indexado).

  // Empezamos por lo RESTRICTIVO: 1 participacion por usuario y reto. La doc de
  // producto dice "maximo 1 video por usuario por reto, SALVO que el evento indique
  // otra cosa" -> el producto contempla excepciones. Se mantiene el UNIQUE porque
  // quitarlo despues es una migracion trivial; anadirlo cuando ya hay datos que lo
  // violan es un infierno. Las excepciones por evento se abordaran cuando lleguen.
  @@unique([challengeId, userId])
  @@index([userId])
  @@index([status])
  // Bloqueo por moderacion: se consulta al iniciar una participacion ("¿puede volver a participar?").
  @@index([retiradaMotivo])
  // Ranking dentro de un reto: los mas votados primero. (Este indice ya cubre las
  // busquedas por challengeId como prefijo, asi que no hay un @@index([challengeId]) suelto.)
  @@index([challengeId, voteCount])
}

/// Resultado del cierre de un reto: un HECHO DE NEGOCIO con fila propia.
///
/// DECISION CONSCIENTE — se elige un modelo explicito en vez de derivar el ganador
/// de PointsLedger (reason=WIN_CHALLENGE) porque:
///   (a) el cierre de un reto es un evento de negocio que merece su propia fila;
///   (b) hace falta igualmente para mostrar el PALMARES en el perfil;
///   (c) evita recorrer PointsLedger para contar victorias.
/// El TopRanking mensual ("mejores perfiles del mes por eventos ganados") se calcula
/// contando aqui por usuario y mes con @@index([userId, createdAt]). El mes es UTC
/// (ver RESET_TIMEZONE en constants). La concesion de puntos/premio sigue pasando por
/// sus ledgers; esta fila es el registro del resultado, no el movimiento de dinero.
///
/// userId/submissionId SIN FK (como los ledgers): el resultado sobrevive a la
/// anonimizacion del ganador. FK solo a Challenge, que persiste.
model ChallengeResult {
  id               String   @id @default(cuid())
  challengeId      String
  userId           String // ganador (columna suelta, sin FK)
  submissionId     String // participacion ganadora (columna suelta, sin FK)
  rank             Int // posicion: 1 = ganador, 2, 3...
  prizeAmountCents Int      @default(0) // premio OTORGADO (se congela aqui aunque cambie el del reto)
  currency         String   @db.Char(3)
  createdAt        DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Restrict)

  @@unique([challengeId, rank]) // una posicion, un resultado
  @@unique([challengeId, userId]) // un usuario no ocupa dos posiciones en el mismo reto
  @@index([userId, createdAt]) // victorias por usuario y mes (TopRanking mensual, UTC)
}

// ============================================================================
// ANTIFRAUDE: VOTO
// ============================================================================

/// Voto de un usuario DENTRO DE UN RETO.
///
/// EL MODELO: una fila por (usuario, reto), con `submissionId` MUTABLE.
///   - votar  = INSERT
///   - mover  = UPDATE de `submissionId` (la misma fila cambia de destino)
///   - quitar = DELETE
/// No hay "historial de a quien votaste antes": el voto es UNO y esta donde esta.
///
/// UN VOTO POR RETO, ESTRUCTURAL — lo IMPIDE la base de datos con
/// `@@unique([userId, challengeId])`, no una comprobacion en codigo (que sufre
/// condiciones de carrera). Dos INSERT simultaneos a participaciones distintas del
/// mismo reto -> uno gana, el otro recibe error de clave duplicada, su transaccion
/// revierte entera y el contador no sube.
///
/// POR QUE UNA CONSTRAINT FIJA Y NO UNA POLITICA CONFIGURABLE: hubo una columna
/// `Challenge.maxVotesPerUser` pensada para permitir N votos por reto. Se retiro al
/// implementar la votacion, por el MISMO criterio que el @@unique de Submission:
/// QUITAR un unique cuando el producto lo pida es una migracion trivial; ANADIRLO
/// cuando ya hay datos que lo violan es un infierno. Y una politica configurable que
/// el codigo no aplica es peor que no tenerla: el admin cree que configura algo que
/// el sistema ignora. Cuando exista un evento que admita varios votos, se relaja aqui.
///
/// Sin FK a User/Submission a proposito (igual que los ledgers): el registro de
/// voto es material de auditoria antifraude y debe sobrevivir desvinculado.
model Vote {
  id     String @id @default(cuid())
  userId String

  /// A QUE participacion apunta el voto AHORA MISMO. Cambia al mover el voto.
  submissionId String

  /// challengeId DENORMALIZADO (copiado de Submission al votar; jamas del cliente).
  /// Es la mitad del UNIQUE que garantiza "un voto por reto", asi que NO es un simple
  /// cache: sin el, la regla no se podria imponer en la BD sin cruzar con Submission.
  challengeId String

  // IP HASHEADA, nunca en claro (seccion 5). Dato personal de antifraude con
  // retencion de 90 dias: un job RETENTION_PURGE la pone a NULL pasado el plazo.
  // Sirve para detectar "un video que recibe >30% de votos desde IPs similares"
  // (se agrupa por ipHash dentro de una submission, via el indice de submissionId).
  ipHash    String?
  createdAt DateTime @default(now())

  /// LA REGLA: un voto por usuario y reto. Cubre tambien las busquedas por
  /// [userId, challengeId], asi que no hace falta un @@index suelto para eso.
  @@unique([userId, challengeId])
  @@index([submissionId])
  // Antifraude: "cuenta nueva que vota >5 veces en los primeros 10 min".
  @@index([userId, createdAt])
}

// ============================================================================
// LEDGERS (SOLO-INSERCION) — LA PARTE MAS CRITICA
// ============================================================================

/// Libro mayor de PUNTOS. Solo-insercion: una fila por movimiento.
///
/// INTEGRIDAD DE SALDO (por que nunca se desincroniza):
///  1. Toda operacion lleva `idempotencyKey` UNICA. Reintentos, webhooks
///     duplicados o dobles clics NO duplican el movimiento: el segundo INSERT
///     viola el UNIQUE y se rechaza.
///  2. En una sola transaccion: SELECT ... FOR UPDATE sobre la fila del User
///     (bloquea), se inserta la fila del ledger, y se actualiza
///     User.pointsBalance += delta. El bloqueo serializa a los concurrentes.
///     (Prisma no expone FOR UPDATE en su API declarativa: se hace con queryRaw
///      dentro de una $transaction interactiva, en la capa de servicio.)
///  3. Nunca se hace UPDATE directo del saldo sin insertar su fila de ledger.
///  4. Un job LEDGER_RECONCILE comprueba que User.pointsBalance == SUM(delta) y alerta.
model PointsLedger {
  id             String   @id @default(cuid())
  userId         String
  delta          Int // +/- puntos
  reason         String // WIN_CHALLENGE, INVITE_FRIEND, TOP20... (union en constants)
  refType        String? // CHALLENGE, SUBMISSION...
  refId          String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([refType, refId])
}

/// Libro mayor de DINERO (centimos). Mismas garantias que PointsLedger.
/// Puntos y dinero son ledgers SEPARADOS y no se convierten entre si.
///
/// INVARIANTE (moneda unica por usuario): todas las filas de WalletLedger de un
/// mismo usuario comparten `currency`. El saldo denormalizado User.walletBalanceCents
/// asume esto: si un usuario tuviera movimientos en dos monedas, el saldo dejaria de
/// significar nada y la reconciliacion sumaria manzanas con naranjas. El job
/// LEDGER_RECONCILE DEBE verificar que un usuario no tiene movimientos en monedas
/// distintas (COUNT(DISTINCT currency) <= 1) y alertar si ocurre. Un invariante que
/// nadie comprueba deja de serlo. (Multi-moneda real: tabla WalletAccount por
/// (usuario, moneda), y este invariante se sustituye por "por cuenta".)
///
/// Retiradas de premio: se crean como fila en estado PENDING/APPROVED y un admin
/// las aprueba manualmente antes de pagar. Nunca pagos automaticos al usuario.
model WalletLedger {
  id             String   @id @default(cuid())
  userId         String
  amountCents    Int // +/- en centimos
  currency       String   @db.Char(3) // la fija la app desde DEFAULT_CURRENCY
  entryType      String // CREDIT, DEBIT (union en constants)
  status         String   @default("COMPLETED") // PENDING, APPROVED, PAID, REJECTED, COMPLETED (union en constants)
  idempotencyKey String   @unique
  refType        String?
  refId          String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([refType, refId])
}

// ============================================================================
// BOOST — comprar/regalar (creditos) y activar (puesto destacado) SEPARADOS
// ============================================================================

/// Creditos de Boost del usuario. SOLO-INSERCION: movimientos, no un contador
/// suelto (misma filosofia que los ledgers de puntos/dinero). El saldo disponible
/// es User.boostBalance (cache denormalizado, reconciliable con SUM(delta)).
///
///  - delta +N: COMPRA de un paquete (1/5/10, con importe y pago Stripe) o REGALO
///    del VIP (1/semana, sin importe ni pago).
///  - delta -1: ACTIVACION (gastar un boost; crea ademas una fila BoostActivation).
///
/// Los boosts NO caducan: se usan cuando el usuario quiera. Por eso comprar y activar
/// estan separados; un boost comprado y no usado es simplemente saldo positivo aqui.
///
/// INTEGRIDAD DE SALDO: identica a los otros ledgers. Nunca un UPDATE suelto de
/// User.boostBalance sin insertar su fila aqui; el debito/credito y el ajuste del
/// saldo van en la MISMA transaccion con SELECT ... FOR UPDATE sobre la fila del
/// User; `idempotencyKey` UNICA evita duplicar movimientos; y LEDGER_RECONCILE
/// comprueba que User.boostBalance == SUM(delta).
model BoostLedger {
  id     String @id @default(cuid())
  userId String
  delta  Int // +N al obtener, -1 al activar
  reason String // PURCHASE, VIP_WEEKLY, ACTIVATION, REFUND, ADMIN_ADJUST (union en constants)

  // Solo en compras (reason=PURCHASE): importe y moneda del pago. Null en regalos
  // VIP y en activaciones (que no tienen importe).
  amountCents Int?
  currency    String? @db.Char(3)

  refType        String? // STRIPE_PAYMENT, BOOST_ACTIVATION, VIP_SUBSCRIPTION...
  refId          String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([refType, refId])
}

/// Activacion de Boost: ocupa el espacio DESTACADO con el PERFIL del usuario
/// (no un video) durante ~1h. No tiene importe. El puesto destacado se resuelve
/// por CONSULTA sobre activaciones vigentes (startsAt/expiresAt), no por el job.
///
/// LIMITE 3/DIA — CUIDADO CON LA CONDICION DE CARRERA: contar las activaciones del
/// dia y despues insertar es el mismo patron peligroso que evitamos en el voto
/// (entre el SELECT y el INSERT cabe otra peticion; dos activaciones simultaneas
/// veen "2 hoy" y pasan ambas -> 4). La activacion completa va en UNA SOLA
/// transaccion con SELECT ... FOR UPDATE sobre la fila del User, y dentro:
///   1. cuenta las BoostActivation del usuario de hoy (indice [userId, startsAt];
///      "hoy" = dia UTC, ver RESET_TIMEZONE y BOOST_DAILY_LIMIT en constants),
///   2. verifica saldo (User.boostBalance > 0) y limite (< BOOST_DAILY_LIMIT hoy),
///   3. inserta el movimiento -1 en BoostLedger y decrementa User.boostBalance,
///   4. inserta esta BoostActivation.
/// El bloqueo de la fila del User serializa a los concurrentes y el limite se vuelve
/// real. (Implementacion en la Fase 6.)
model BoostActivation {
  id        String   @id @default(cuid())
  userId    String
  startsAt  DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([startsAt, expiresAt]) // destacados vigentes ahora mismo
  @@index([userId, startsAt]) // limite de 3/dia por usuario
}

// ============================================================================
// MODERACION Y AUDITORIA
// ============================================================================

/// Denuncia de contenido o usuario.
/// Nota: `targetType` contempla COMMENT, pero el modelo `Comment` (comentarios en
/// los videos) llega en la FASE 1 a proposito; no es un olvido. Report se deja
/// preparado para no tener que migrar la tabla cuando los comentarios existan.
model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String // VIDEO, SUBMISSION, USER, COMMENT (union en constants)
  targetId   String
  reason     String
  status     String   @default("OPEN") // OPEN, REVIEWING, RESOLVED, DISMISSED (union en constants)
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
}

/// Registro de auditoria: acciones de admin, payouts, moderacion, ajustes.
/// Sin FK (actorId puede quedar desvinculado si el actor se anonimiza).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
}

// ============================================================================
// INFRAESTRUCTURA: COLA DE TRABAJOS Y RATE LIMIT
// ============================================================================

/// Cola de trabajos (tabla + disparador externo por GitHub Actions).
///
/// Reclamacion PORTABLE, sin SKIP LOCKED: cada ejecucion genera un token y hace
///   UPDATE Job SET status='RUNNING', lockedBy=<token>, lockedAt=NOW()
///   WHERE status='PENDING' AND runAt<=NOW() ORDER BY runAt LIMIT n
/// y luego relee sus filas por `lockedBy=<token>`. El UPDATE es atomico, asi que
/// dos ejecuciones simultaneas nunca reclaman la misma fila aunque no exista
/// SKIP LOCKED. Todos los handlers son idempotentes.
model Job {
  id             String    @id @default(cuid())
  type           String // union en constants (JobType)
  payload        Json?
  status         String    @default("PENDING") // PENDING, RUNNING, DONE, FAILED (union en constants)
  runAt          DateTime // cuando debe ejecutarse (UTC)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lockedAt       DateTime?
  lockedBy       String? // token de la ejecucion que reclamo la fila
  lastError      String?   @db.Text
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())

  @@index([status, runAt]) // indice del reclamo
  @@index([lockedBy])
}

/// Rate limiting por ventana fija en la base de datos (sin Redis).
///
/// EL INCREMENTO DEBE SER ATOMICO: `INSERT ... ON DUPLICATE KEY UPDATE
/// count = count + 1` via CONSULTA CRUDA (queryRaw). NO usar el `upsert` de Prisma:
/// hace lectura y luego escritura (read-then-write), con la MISMA ventana de carrera
/// que estamos evitando en todo el sistema — dos peticiones simultaneas leerian el
/// mismo `count` y una perderia su incremento, dejando pasar mas de lo permitido.
model RateLimit {
  id          String   @id @default(cuid())
  key         String // "login:ip:<hash>", "vote:user:<id>"
  windowStart DateTime
  count       Int      @default(0)

  @@unique([key, windowStart])
  @@index([windowStart])
}

/// Estado interno del sistema (clave-valor DURABLE). Sobrevive a un reinicio del
/// worker, que es justo lo que necesita la HISTERESIS del aviso de FAILED: avisar al
/// CRUZAR el umbral y callar hasta que baje y lo cruce otra vez, sin reavisar en cada
/// vuelta ni al reiniciar. Generico y reutilizable (futuro: estado de LEDGER_RECONCILE,
/// flags operativos). No lleva datos personales.
model SystemState {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
