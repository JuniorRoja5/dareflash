# =============================================================================
# DareFlash — plantilla de variables de entorno
# -----------------------------------------------------------------------------
# COPIA este archivo a `.env` y rellena los valores. `.env` NUNCA se commitea.
# En produccion las variables viven FUERA del repositorio, en el entorno del servidor.
# Claves unicas por entorno; rotar si se filtran.
# =============================================================================

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Base de datos (MySQL/MariaDB)
# NINGUNA CLAVE ESCRITA EN EL REPOSITORIO, ni de desarrollo: las pones tú en tu .env.
#
# MariaDB de desarrollo (docker-compose.dev.yml las lee de aquí; inventa las tuyas). Solo se aplican al
# CREAR el volumen: si ya tienes uno, pon las que tenía.
DEV_MARIADB_ROOT_PASSWORD=
DEV_MARIADB_PASSWORD=
#
# La URL de la app. En LOCAL: usuario `dareflash`, la clave de DEV_MARIADB_PASSWORD, host 127.0.0.1,
# puerto 3307 (el del host en docker-compose.dev.yml), base `dareflash` y `?connection_limit=5` al
# final (ese límite lo usa el CLI de PRISMA en las migraciones, no el runtime). Forma: mysql://…@…/…
DATABASE_URL=
#
# La de los TESTS (vitest la lee de este .env; solo las TEST_*): el mismo servidor y la base
# `dareflash_test`. El globalSetup crea y BORRA una base por worker, así que el usuario necesita poder
# crear bases de datos.
TEST_DATABASE_URL=

# Pool de conexiones del RUNTIME (el de la app, distinto del `connection_limit` de arriba).
# OPCIONAL: sin ella se usa el default del codigo (15). Esta aqui para poder AFINARLA en el servidor
# sin reconstruir la imagen. Subirla mucho no acelera nada y quita conexiones a MariaDB.
# DB_CONNECTION_LIMIT=15

# Auth (NO hay Google OAuth: registro solo email + contrasena)
# OBLIGATORIA: clave HMAC del token CSRF y del hash de IP del rate-limit.
# Generar en HEX (sin +,/,= que rompen el guardado de variables): openssl rand -hex 32
AUTH_SECRET=

# Bunny Stream (video). OBLIGATORIAS: sin ellas la app no arranca (fail-fast).
# La API key va SOLO en servidor (nunca al cliente). Los valores, del panel de Bunny.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_CDN_HOSTNAME=                  # el hostname de la pull-zone (…b-cdn.net)
# Clave de TOKEN AUTHENTICATION de la pull-zone (firma las URLs de reproduccion). OBLIGATORIA y
# DISTINTA de la API key: firmar con la API key da 403.
BUNNY_TOKEN_AUTH_KEY=
# (Hubo aqui una BUNNY_PURGE_API_KEY para purgar el CDN. Se retiro: la miniatura personalizada NO
# sobrescribe `thumbnail.jpg`, Bunny le da un nombre propio, asi que su URL es nueva y nunca estuvo
# cacheada. No habia nada que purgar. Se puede borrar del entorno.)

# Stripe
STRIPE_SECRET_KEY=
# UN SECRETO DE FIRMA POR ENDPOINT. En Stripe cada webhook se da de alta por separado y cada uno
# tiene el suyo: el de abajo es el de /api/boost/webhook y el otro el de /api/vip/webhook. Poner el
# mismo en los dos no rompe nada visible — el cobro se hace y la pagina responde—, simplemente toda
# entrega falla la firma y la fila no se escribe nunca.
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_VIP=

# Pagos: cifrado de los DATOS DE COBRO (IBAN / direccion de cripto) guardados en la BD.
# OPCIONAL en el arranque, pero sin ella el rail de cobro FALLA CERRADO: no se puede guardar un
# metodo de cobro ni pedir una retirada, y la pantalla lo dice. Preferimos eso a guardar un IBAN en
# claro "mientras tanto", que es una fuga silenciosa.
# CLAVE PROPIA, NO derivada de AUTH_SECRET: rotar la de sesiones no puede dejar ilegibles los datos
# de pago ya guardados, ni al contrario. Generar: openssl rand -hex 32
# ROTARLA invalida lo ya cifrado: el panel marca esas filas como ilegibles en vez de tumbar la cola.
PAGOS_SECRET=

# Email (SMTP AUTENTICADO; el envio pasa por la cola/worker). EMAIL_FROM debe COINCIDIR con
# SMTP_USER (la cuenta autenticada): si no, el servidor rechaza o el SPF falla.
EMAIL_FROM=noreply@ejemplo.test
SMTP_HOST=mail.ejemplo.test
SMTP_PORT=                    # 587 (STARTTLS) o 465 (TLS directo)
SMTP_USER=noreply@ejemplo.test
SMTP_PASSWORD=

# Cola de trabajos
CRON_SECRET=                 # openssl rand -base64 32

# Observabilidad
SENTRY_DSN=
