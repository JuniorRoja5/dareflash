# =============================================================================
# DareFlash — plantilla de variables de entorno
# -----------------------------------------------------------------------------
# COPIA este archivo a `.env` y rellena los valores. `.env` NUNCA se commitea.
# En produccion las variables viven en /root/dareflash-config/.env del VPS, no en el repo.
# Claves unicas por entorno; rotar si se filtran.
# =============================================================================

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Base de datos (MySQL/MariaDB)
# El `connection_limit` de la URL lo usa el CLI de PRISMA (migraciones), no el runtime.
# En LOCAL, estos valores coinciden con docker-compose.dev.yml (puerto 3307 en el host).
DATABASE_URL="mysql://dareflash:dareflash_dev@127.0.0.1:3307/dareflash?connection_limit=5"

# Pool de conexiones del RUNTIME (el de la app, distinto del `connection_limit` de arriba).
# OPCIONAL: sin ella se usa el default del codigo (15). Esta aqui para poder AFINARLA en el VPS sin
# reconstruir la imagen. Subirla mucho no acelera nada y quita conexiones a MariaDB (max 100).
# DB_CONNECTION_LIMIT=15

# Auth (NO hay Google OAuth: registro solo email + contrasena)
# OBLIGATORIA: clave HMAC del token CSRF y del hash de IP del rate-limit.
# Generar en HEX (sin +,/,= que rompen el guardado de variables): openssl rand -hex 32
AUTH_SECRET=

# Bunny Stream (video). OBLIGATORIAS: sin ellas la app no arranca (fail-fast).
# La API key va SOLO en servidor (nunca al cliente). Valores de PLANTILLA (falsos): sustituir por
# los reales del panel de Bunny en el .env local / el fichero de entorno del VPS.
BUNNY_STREAM_LIBRARY_ID=tu-library-id-aqui
BUNNY_STREAM_API_KEY=tu-api-key-de-bunny-aqui
BUNNY_CDN_HOSTNAME=tu-pull-zone.b-cdn.net
# Clave de TOKEN AUTHENTICATION de la pull-zone (firma las URLs de reproduccion). OBLIGATORIA y
# DISTINTA de la API key: firmar con la API key da 403.
BUNNY_TOKEN_AUTH_KEY=tu-clave-de-token-auth-aqui
# Clave de la API DE CUENTA (api.bunny.net) — la UNICA que autoriza purgar el CDN. Es una TERCERA
# clave, distinta de las dos de arriba. OPCIONAL: sin ella la app arranca igual, pero una miniatura
# personalizada nueva NO se ve hasta que caduca la cacheada en el borde (el job de purga lo avisa
# en el log). Se saca de bunny.net -> Account Settings -> API.
BUNNY_PURGE_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (SMTP AUTENTICADO contra el servidor de correo propio, mail.dareflash.com; el envio
# pasa por la cola/worker). EMAIL_FROM debe COINCIDIR con SMTP_USER (la cuenta autenticada):
# si no, el servidor rechaza o el SPF falla.
EMAIL_FROM=noreply@dareflash.com
SMTP_HOST=mail.dareflash.com
SMTP_PORT=                    # 587 (STARTTLS) o 465 (TLS directo)
SMTP_USER=noreply@dareflash.com
SMTP_PASSWORD=

# Cola de trabajos
CRON_SECRET=                 # openssl rand -base64 32

# Observabilidad
SENTRY_DSN=
