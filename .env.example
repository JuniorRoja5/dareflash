# =============================================================================
# DareFlash — plantilla de variables de entorno
# -----------------------------------------------------------------------------
# COPIA este archivo a `.env` y rellena los valores. `.env` NUNCA se commitea.
# En produccion las variables viven en hPanel (Hostinger), no en el repo.
# Claves unicas por entorno; rotar si se filtran.
# =============================================================================

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Base de datos (MySQL)
# El `connection_limit` debe ajustarse al limite del plan compartido (PENDIENTE hPanel).
# En LOCAL, estos valores coinciden con docker-compose.dev.yml (puerto 3307 en el host).
DATABASE_URL="mysql://dareflash:dareflash_dev@127.0.0.1:3307/dareflash?connection_limit=5"

# Auth (NO hay Google OAuth: registro solo email + contrasena)
# OBLIGATORIA: clave HMAC del token CSRF y del hash de IP del rate-limit.
# Generar en HEX (sin +,/,= que rompen el guardado de variables): openssl rand -hex 32
AUTH_SECRET=

# Bunny.net
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_CDN_HOSTNAME=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (SMTP del servidor de correo de Hostinger; el envio pasa por la cola)
EMAIL_FROM=no_reply@dareflash.com
SMTP_HOST=
SMTP_PORT=                    # p.ej. 465 (SSL) o 587 (STARTTLS)
SMTP_USER=
SMTP_PASSWORD=

# Cola de trabajos
CRON_SECRET=                 # openssl rand -base64 32

# Observabilidad
SENTRY_DSN=
